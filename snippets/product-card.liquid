{% doc %}
  Renders a product card for grids.

  @param {product} product - Product to render
  @param {string} [css_class] - Optional extra class

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

<article class="group overflow-hidden rounded-2xl bg-white shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl {{ css_class }}">
  <a href="{{ product.url }}" class="block text-sh-brown no-underline">
    {% if product.featured_image %}
      {{ product.featured_image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          class: 'h-56 w-full object-cover md:h-72',
          alt: product.featured_image.alt | default: product.title
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'h-56 w-full object-cover md:h-72' }}
    {% endif %}
    <div class="p-4">
      <h3 class="mb-2 text-lg font-semibold text-sh-brown">{{ product.title | escape }}</h3>
      <p class="text-xl font-bold text-sh-accent">
        {% if product.price_varies %}
          {% assign from_price = product.price_min | money %}
          {{ 'products.from_price' | t: price: from_price }}
        {% else %}
          {{ product.price | money }}
        {% endif %}
      </p>
      {% if product.metafields.custom.eggless_available %}
        <span class="mt-2 inline-block rounded-full bg-[#fdecea] px-3 py-1 text-sm font-semibold text-[#a12a1f]">{{ 'products.eggless_available' | t }}</span>
      {% endif %}
    </div>
  </a>
</article>
