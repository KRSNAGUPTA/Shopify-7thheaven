{%- comment -%}
  Reusable product card.

  Usage:
    {% render 'product-card', product: product %}

  Optional params:
    show_badges     — bool, default true
    show_description — bool, default true
    lazy            — bool, default true (use 'eager' for above-the-fold grids)
    sizes           — string, default '(min-width: 1024px) 380px, 50vw'
    class           — string, extra wrapper classes
{%- endcomment -%}

{%- liquid
  assign show_badges = show_badges | default: true
  assign show_description = show_description | default: true
  assign lazy = lazy | default: true
  assign sizes = sizes | default: '(min-width: 1024px) 380px, 50vw'
  assign extra_class = class | default: ''

  # Pick the lowest-priced available variant. Fallback to first variant if none available.
  assign target_variant = nil
  for v in product.variants
    if v.available
      if target_variant == nil or v.price < target_variant.price
        assign target_variant = v
      endif
    endif
  endfor
  if target_variant == nil
    assign target_variant = product.variants.first
  endif

  assign has_variants = false
  if product.variants.size > 1
    assign has_variants = true
  endif

  if lazy
    assign loading_attr = 'lazy'
  else
    assign loading_attr = 'eager'
  endif
-%}

<article class="group flex flex-col {{ extra_class }}" data-product-card>

  {%- comment -%}
    Image + badges.
    The frame is a fixed square (aspect-square + shrink-0 + overflow-hidden).
    The image is absolutely positioned and fills the frame, so its natural
    size can never change the card height. object-contain keeps the whole
    product visible; switch to object-cover to fill the frame edge to edge.
  {%- endcomment -%}
  <div class="relative mb-3 aspect-square w-full shrink-0 overflow-hidden rounded-2xl sm:mb-4">
    {%- if show_badges -%}
      {%- if product.available == false -%}
        <span class="absolute top-1 left-1 sm:top-2 sm:left-2 z-10 rounded-full bg-sh-brown-dark px-2.5 py-1 text-[0.6rem] sm:text-[0.65rem] font-bold uppercase tracking-widest text-white">
          Sold Out
        </span>
      {%- elsif product.compare_at_price_max > product.price_min -%}
        <span class="absolute top-1 left-1 sm:top-2 sm:left-2 z-10 rounded-full bg-sh-primary-dark px-2.5 py-1 text-[0.6rem] sm:text-[0.65rem] font-bold uppercase tracking-widest text-white">
          Sale
        </span>
      {%- endif -%}
    {%- endif -%}

    <a
      href="{{ product.url }}"
      class="absolute inset-0 block cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2"
      aria-label="{{ product.title | escape }}"
    >
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 700
          | image_tag:
            widths: '300, 500, 700',
            sizes: sizes,
            class: 'absolute inset-0 h-full w-full object-contain transition-transform duration-500 ease-out will-change-transform motion-reduce:transition-none',
            loading: loading_attr,
            alt: product.featured_media.alt | default: product.title
        }}
      {%- else -%}
        <div class="absolute inset-0 flex items-center justify-center text-sm text-sh-text-light">
          No Image
        </div>
      {%- endif -%}
    </a>
  </div>

  {%- comment -%}Info{%- endcomment -%}
  <div class="flex flex-1 flex-col gap-1.5 sm:gap-2 px-0.5 sm:px-1">

    {%- comment -%}
      Title — fixed to exactly 2 lines tall.
      leading-snug = 1.375, so 2 lines = 2.75em.
      height (not min-height) caps it; overflow:hidden + line-clamp-2 clip.
    {%- endcomment -%}
    <h3
      class="text-sm sm:text-base lg:text-lg font-medium leading-snug text-sh-brown line-clamp-2"
      style="height: 2.75em; overflow: hidden;"
    >
      <a href="{{ product.url }}" class="cursor-pointer hover:text-sh-primary-dark focus-visible:outline-none focus-visible:underline">
        {{ product.title }}
      </a>
    </h3>

    {%- comment -%}
      Price — shows lowest variant's price (or range if you prefer).
      Compare-at shows only if that same variant is discounted.
    {%- endcomment -%}
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      <span class="font-sniglet text-lg sm:text-xl lg:text-2xl tracking-tight text-sh-primary-dark">
        {%- if has_variants -%}
          {{ target_variant.price | money }}
        {%- else -%}
          {{ target_variant.price | money }}
        {%- endif -%}
      </span>
      {%- if target_variant.compare_at_price > target_variant.price -%}
        <s class="text-xs sm:text-sm text-sh-text-light/80">
          {{ target_variant.compare_at_price | money }}
        </s>
      {%- endif -%}
    </div>

    {%- comment -%}
      Description — fixed to exactly 2 lines tall.
      leading-relaxed = 1.625, so 2 lines = 3.25em.
      height (not min-height) caps it; overflow:hidden + line-clamp-2 clip.
      truncate is a payload optimization only — CSS does the visual clamp.
    {%- endcomment -%}
    {%- if show_description and product.description != blank -%}
      <p
        class="mt-1 hidden text-xs leading-relaxed text-sh-text-light line-clamp-2 sm:block"
        style="height: 3.25em; overflow: hidden;"
      >
        {{ product.description | strip_html | truncate: 120 }}
      </p>
    {%- endif -%}

    {%- comment -%}Actions — mt-auto pins this row to the bottom of the card{%- endcomment -%}
    <div class="mt-auto pt-3 flex items-stretch gap-2 sm:pt-4">
      {%- if product.available -%}
        {%- comment -%}
          Buy Now — always direct. If product has variants, this goes to the
          lowest-priced available variant's cart URL. If it has variants and the
          customer might want a different size, the product page is one tap away
          via the title link.
        {%- endcomment -%}
        <a
          href="/cart/{{ target_variant.id }}:1"
          class="flex-1 inline-flex cursor-pointer items-center justify-center rounded-full bg-sh-primary px-4 py-2.5 text-xs font-semibold text-white transition-colors duration-200 hover:bg-sh-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 sm:py-3 sm:text-sm"
        >
          Buy Now
        </a>

        {%- comment -%}Secondary: AJAX add-to-cart icon (adds the same variant){%- endcomment -%}
        {%- form 'product', product, class: 'ajax-add-to-cart-form shrink-0' -%}
          <input type="hidden" name="id" value="{{ target_variant.id }}">
          <button
            type="submit"
            name="add"
            aria-label="Add {{ product.title | escape }} to cart"
            class="group/cart inline-flex h-full w-11 cursor-pointer items-center justify-center rounded-full border border-sh-border bg-white text-sh-brown transition-colors duration-200 hover:border-sh-primary hover:bg-sh-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 sm:w-12"
          >
            <svg class="h-4 w-4 transition-transform duration-200 group-hover/cart:scale-110" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </button>
        {%- endform -%}
      {%- else -%}
        <button
          type="button"
          disabled
          class="flex-1 cursor-not-allowed rounded-full bg-sh-text-light/40 px-4 py-2.5 text-xs font-semibold text-white sm:py-3 sm:text-sm"
        >
          Sold Out
        </button>
      {%- endif -%}
    </div>
  </div>
</article>