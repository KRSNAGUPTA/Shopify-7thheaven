<section class="full-width py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center">
      <h1 class="mb-2">{{ section.settings.heading }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="text-lg text-sh-text-light">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {% for block in section.blocks %}
        <article class="rounded-2xl border border-sh-border bg-white p-6 shadow-sm" {{ block.shopify_attributes }}>
          <h2 class="mt-0">{{ block.settings.name }}</h2>
          {% if block.settings.address != blank %}
            <p class="whitespace-pre-line text-sh-text-light">{{ block.settings.address }}</p>
          {% endif %}
          {% if block.settings.hours != blank %}
            <p><strong>{{ 'stores.hours' | t }}:</strong> {{ block.settings.hours }}</p>
          {% endif %}
          {% if block.settings.phone != blank %}
            <p><strong>{{ 'stores.phone' | t }}:</strong> <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></p>
          {% endif %}
          {% if block.settings.map_url != blank %}
            <a
              href="{{ block.settings.map_url }}"
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex items-center justify-center gap-2 rounded-xl border-2 border-sh-accent px-6 py-3 font-semibold text-sh-accent transition-all duration-200 hover:bg-sh-accent-light active:scale-95"
            >
              {{ 'stores.directions' | t }}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store locator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our stores"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick up or get delivery from Andheri or Thane"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "7th Heaven Andheri" },
        { "type": "textarea", "id": "address", "label": "Address", "default": "Andheri West, Mumbai" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "10 AM – 11 PM" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "1800-XXX-XXXX" },
        { "type": "url", "id": "map_url", "label": "Google Maps URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store locator",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "name": "7th Heaven Andheri",
            "address": "Andheri West, Mumbai 400053",
            "hours": "10 AM – 11 PM",
            "phone": "1800-XXX-XXXX",
            "map_url": "https://maps.google.com/?q=Andheri+West+Mumbai"
          }
        },
        {
          "type": "store",
          "settings": {
            "name": "7th Heaven Thane",
            "address": "Thane West, Thane 400601",
            "hours": "10 AM – 11 PM",
            "phone": "1800-XXX-XXXX",
            "map_url": "https://maps.google.com/?q=Thane+West"
          }
        }
      ]
    }
  ]
}
{% endschema %}
