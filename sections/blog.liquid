{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<section class="full-width py-12 md:py-16">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h1 class="mb-8">{{ blog.title }}</h1>

    {% paginate blog.articles by 5 %}
      <div class="space-y-8">
        {% for article in blog.articles %}
          <article class="overflow-hidden rounded-2xl border border-sh-border bg-white shadow-sm">
            {% if article.image %}
              {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'w-full object-cover' }}
            {% endif %}
            <div class="p-6">
              <h2 class="mb-2 text-2xl">
                {{ article.title | link_to: article.url }}
              </h2>
              {% assign date = article.published_at | time_tag: format: 'date' %}
              <p class="text-sm text-sh-text-light">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
              <p class="mt-3">{{ article.excerpt }}</p>
            </div>
          </article>
        {% endfor %}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="mt-8">
          {{- paginate | default_pagination -}}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
