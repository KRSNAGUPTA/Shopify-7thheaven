{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="full-width py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h1 class="mb-8">{{ 'collections.title' | t }}</h1>

    {% liquid
      if section.settings.grid_item_width == 'collections--compact'
        assign card_size = '160px'
      else
        assign card_size = '280px'
      endif
    %}

    <div
      class="grid grid-cols-[repeat(auto-fill,minmax(min(var(--collection-card-size),100%),1fr))]"
      style="--collection-card-size: {{ card_size }}; gap: {{ section.settings.grid_gap }}px;"
    >
      {% for collection in collections %}
        <a class="flex w-full flex-col text-sh-brown no-underline" href="{{ collection.url }}">
          {% if collection.featured_image %}
            {% render 'image',
              class: 'aspect-square w-full rounded-xl',
              image: collection.featured_image,
              width: 600,
              height: 600,
              crop: 'center'
            %}
          {% endif %}

          <div class="mt-3">
            <p class="font-semibold">{{ collection.title }}</p>

            {% if collection.description %}
              <p class="text-sm text-sh-text-light">{{ collection.description | strip_html | truncatewords: 15 }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
