<section class="full-width py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {% if section.settings.heading != blank %}
      <h2 class="mb-8 text-center">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.collection.url | default: '#' }}"
          {{ block.shopify_attributes }}
          class="group block text-center text-sh-brown no-underline"
        >
          {% if block.settings.image != blank %}
            {{ block.settings.image
              | image_url: width: 400
              | image_tag:
                loading: 'lazy',
                class: 'aspect-square w-full rounded-2xl object-cover transition-transform duration-300 group-hover:scale-105',
                alt: block.settings.title | default: block.settings.collection.title
            }}
          {% endif %}
          <p class="mt-3 font-semibold text-sh-brown">
            {{ block.settings.title | default: block.settings.collection.title }}
          </p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}