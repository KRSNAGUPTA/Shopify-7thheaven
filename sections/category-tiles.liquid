{%- comment -%}
  Category Products Scroll
  - One horizontal carousel per category block
  - Uses shared snippets/product-card.liquid (same card as Featured Collection)
{%- endcomment -%}

{%- assign products_limit = section.settings.products_to_show | default: 6 -%}
{%- assign card_width = 'flex-none shrink-0 snap-start w-[72vw] sm:w-[260px] lg:w-[300px]' -%}

<section
  id="CategoryScroll-{{ section.id }}"
  class="py-12 sm:py-16 lg:py-24 px-5 sm:px-6 lg:px-8 max-w-7xl mx-auto font-body"
>
  {%- comment -%}Section Header{%- endcomment -%}
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="text-center mb-10 sm:mb-12 lg:mb-16 max-w-3xl mx-auto">
      {%- if section.settings.heading != blank -%}
        <h2 class="font-sniglet text-[1.75rem] sm:text-4xl lg:text-5xl font-medium text-sh-brown tracking-[-0.02em] leading-[1.1] [text-wrap:balance]">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mt-3 sm:mt-4 lg:mt-5 mx-auto max-w-xl text-[0.95rem] sm:text-base lg:text-[1.125rem] text-sh-text-light leading-[1.65] [text-wrap:pretty]">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="space-y-12 sm:space-y-14 lg:space-y-20">
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- assign category_title = block.settings.title | default: collection.title -%}

      <div class="category-block" {{ block.shopify_attributes }}>
        {%- comment -%}Category header{%- endcomment -%}
        {%- if category_title != blank -%}
          <div class="mb-5 sm:mb-6 flex items-end justify-between gap-4 border-b border-sh-border pb-3 sm:pb-4">
            <h3 class="font-sniglet text-xl sm:text-2xl lg:text-3xl font-medium text-sh-brown tracking-[-0.01em] leading-tight [text-wrap:balance]">
              {{ category_title }}
            </h3>
            {%- if collection.url != blank -%}
              <a
                href="{{ collection.url }}"
                class="group inline-flex shrink-0 items-center gap-1 rounded-full text-sm font-semibold text-sh-primary-dark transition-colors hover:text-sh-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
              >
                View all
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}Scroll track: bleeds to screen edge on mobile so cards peek in{%- endcomment -%}
        <div
          class="sh-scrollbar-hide -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-pl-5 px-5 pb-2 sm:-mx-6 sm:gap-5 sm:scroll-pl-6 sm:px-6 lg:mx-0 lg:gap-6 lg:scroll-pl-0 lg:px-0"
          style="-webkit-overflow-scrolling: touch;"
        >
          {%- if collection != blank and collection.products.size > 0 -%}
            {%- for product in collection.products limit: products_limit -%}
              {%- assign lazy_flag = true -%}
              {%- if forloop.parentloop.first and forloop.index <= 2 -%}
                {%- assign lazy_flag = false -%}
              {%- endif -%}
              {% render 'product-card',
                product: product,
                show_badges: section.settings.show_badges,
                class: card_width,
                lazy: lazy_flag
              %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="{{ card_width }}" aria-hidden="true">
                <div class="aspect-square rounded-2xl border border-dashed border-sh-border"></div>
                <div class="mt-3 space-y-2 sm:mt-4">
                  <div class="h-4 w-3/4 rounded bg-sh-border/60"></div>
                  <div class="h-5 w-1/3 rounded bg-sh-border/60"></div>
                  <div class="mt-3 flex gap-2">
                    <div class="h-9 flex-1 rounded-full bg-sh-border/60"></div>
                    <div class="h-9 w-11 rounded-full bg-sh-border/60 sm:w-12"></div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Products Scroll",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products per category"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges (Sale / Sold Out)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category (Collection)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Products Scroll",
      "blocks": [
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .sh-scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .sh-scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}