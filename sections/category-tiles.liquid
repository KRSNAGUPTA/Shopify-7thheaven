<section class="page-width" style="padding: 3rem 0;">
  {% if section.settings.heading != blank %}
    <h2 class="title" style="text-align:center;">{{ section.settings.heading }}</h2>
  {% endif %}
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1.5rem;margin-top:2rem;">
    {% for block in section.blocks %}
      <a href="{{ block.settings.collection.url | default: '#' }}" {{ block.shopify_attributes }}
         style="text-decoration:none;color:inherit;text-align:center;">
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', style: 'border-radius:16px;width:100%;aspect-ratio:1;object-fit:cover;' }}
        {% endif %}
        <p style="margin-top:.8rem;font-weight:600;">{{ block.settings.title | default: block.settings.collection.title }}</p>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}