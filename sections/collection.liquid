<section class="sh-section">
  <div class="sh-container">
    <div class="sh-section-title">
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div style="color: var(--sh-text-light); max-width: 40rem; margin: 0 auto;">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>

    {% paginate collection.products by 24 %}
      {% if collection.products.size == 0 %}
        <p class="sh-text-center" style="color: var(--sh-text-light);">{{ 'collections.empty' | t }}</p>
      {% else %}
        <div class="sh-product-grid">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <div class="sh-text-center sh-mt-4">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
