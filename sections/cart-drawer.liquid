<div
  id="sh-cart-drawer"
  class="fixed inset-y-0 right-0 z-[999] flex h-screen w-full max-w-md translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-in-out"
  aria-hidden="true"
  data-money-format="{{ shop.money_format | escape }}"
  data-empty-message="{{ 'cart.empty' | t | escape }}"
>
  <div class="flex items-center justify-between border-b border-sh-border p-6">
    <h3 class="text-xl font-bold text-sh-brown">{{ 'cart.title' | t }}</h3>
    <button
      type="button"
      id="sh-cart-close"
      class="cursor-pointer p-1 text-2xl leading-none text-sh-text-light transition-colors hover:text-sh-brown"
      aria-label="{{ 'cart.close' | t }}"
    >
      ✕
    </button>
  </div>

  <div id="sh-cart-items" class="flex-1 overflow-y-auto p-4"></div>

  <div class="border-t border-sh-border p-6">
    <div class="mb-4 flex items-center justify-between text-lg font-semibold text-sh-brown">
      <strong>{{ 'cart.subtotal' | t }}</strong>
      <strong id="sh-cart-total">₹0</strong>
    </div>
    <a
      href="/checkout"
      id="sh-cart-checkout"
      class="flex w-full items-center justify-center rounded-xl bg-sh-accent px-6 py-3 font-semibold text-white shadow-sm transition-all hover:bg-[#b8234c] active:scale-95"
    >
      {{ 'cart.checkout' | t }}
    </a>
    <button
      type="button"
      id="sh-cart-continue"
      class="mt-2 flex w-full items-center justify-center rounded-xl bg-sh-brown px-6 py-3 font-semibold text-white shadow-sm transition-all hover:bg-[#2a1a12] active:scale-95"
    >
      {{ 'cart.continue' | t }}
    </button>
  </div>
</div>

<div id="sh-cart-overlay" class="fixed inset-0 z-[998] bg-black/40" hidden></div>

{% javascript %}
  (function () {
    var drawer = document.getElementById('sh-cart-drawer');
    var overlay = document.getElementById('sh-cart-overlay');
    var itemsEl = document.getElementById('sh-cart-items');
    var totalEl = document.getElementById('sh-cart-total');
    var closeBtn = document.getElementById('sh-cart-close');
    var continueBtn = document.getElementById('sh-cart-continue');
    var moneyFormat = drawer.getAttribute('data-money-format') || '';
    var emptyMessage = drawer.getAttribute('data-empty-message') || 'Your cart is empty';

    function formatMoney(cents) {
      if (window.Shopify && Shopify.formatMoney && moneyFormat) {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return '₹' + (cents / 100).toLocaleString('en-IN');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function updateCart() {
      var res = await fetch('/cart.js');
      var cart = await res.json();
      var countEls = document.querySelectorAll('[data-cart-count]');
      countEls.forEach(function (el) {
        el.textContent = String(cart.item_count);
        el.hidden = cart.item_count === 0;
      });

      itemsEl.innerHTML = '';
      if (!cart.items.length) {
        itemsEl.innerHTML = '<p class="py-8 text-center text-sh-text-light">' + escapeHtml(emptyMessage) + '</p>';
        totalEl.textContent = formatMoney(0);
        return;
      }

      cart.items.forEach(function (item) {
        var attrs = item.properties || {};
        var html = '<div class="mb-2 border-b border-sh-border p-4">'
          + '<h4 class="mb-1 font-semibold text-sh-brown">' + escapeHtml(item.product_title) + '</h4>'
          + '<p class="text-sm text-sh-text-light">' + escapeHtml(item.variant_title || '') + '</p>';
        if (attrs['Message on cake']) html += '<p class="text-sm text-sh-text-light">Message: "' + escapeHtml(attrs['Message on cake']) + '"</p>';
        if (attrs['Delivery date']) html += '<p class="text-sm text-sh-text-light">Date: ' + escapeHtml(attrs['Delivery date']) + '</p>';
        if (attrs['Delivery slot']) html += '<p class="text-sm text-sh-text-light">Slot: ' + escapeHtml(attrs['Delivery slot']) + '</p>';
        if (attrs['Fulfilment store']) html += '<p class="text-sm text-sh-text-light">Store: ' + escapeHtml(attrs['Fulfilment store']) + '</p>';
        html += '<div class="mt-3 flex items-center justify-between">'
          + '<span class="text-sm">Qty: ' + item.quantity + '</span>'
          + '<strong class="text-sh-accent">' + formatMoney(item.final_line_price) + '</strong></div></div>';
        itemsEl.innerHTML += html;
      });

      totalEl.textContent = formatMoney(cart.total_price);
    }

    function openCart() {
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.hidden = false;
      updateCart();
    }

    function closeCart() {
      drawer.classList.add('translate-x-full');
      drawer.classList.remove('translate-x-0');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.hidden = true;
    }

    document.querySelectorAll('[data-cart-open]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        openCart();
      });
    });

    closeBtn.addEventListener('click', closeCart);
    continueBtn.addEventListener('click', closeCart);
    overlay.addEventListener('click', closeCart);
    document.addEventListener('sh:cart:open', openCart);
    document.addEventListener('sh:cart:updated', updateCart);

    updateCart();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
