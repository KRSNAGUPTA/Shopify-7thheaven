{%- comment -%}
  Trust strip
  - Big Sniglet numbers, small tracked labels
  - Subtle dividers between stats on tablet and up
  - Stays on one row on mobile for up to 3 stats
{%- endcomment -%}

{%- assign count = section.blocks.size -%}
{%- if count == 1 -%}
  {%- assign mobile_cols = 'grid-cols-1' -%}
{%- elsif count == 2 -%}
  {%- assign mobile_cols = 'grid-cols-2' -%}
{%- elsif count == 3 -%}
  {%- assign mobile_cols = 'grid-cols-3' -%}
{%- else -%}
  {%- assign mobile_cols = 'grid-cols-2' -%}
{%- endif -%}

<section class="full-width bg-sh-brown text-white font-body">
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="grid {{ mobile_cols }} gap-x-3 gap-y-8 sm:flex sm:flex-wrap sm:items-stretch sm:justify-center sm:gap-0">
      {%- for block in section.blocks -%}
        <div
          class="flex flex-col items-center justify-center text-center sm:flex-1 sm:basis-0 sm:px-6 lg:px-10 {% unless forloop.first %}sm:border-l sm:border-white/10{% endunless %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.value != blank -%}
            <strong class="font-sniglet block text-[1.75rem] font-medium leading-none tracking-[-0.02em] text-white sm:text-4xl lg:text-5xl">
              {{ block.settings.value }}
            </strong>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="mt-2 block max-w-[10rem] text-[0.6875rem] font-semibold uppercase leading-snug tracking-[0.12em] text-sh-cream/80 [text-wrap:balance] sm:mt-3 sm:text-xs lg:text-[0.8125rem]">
              {{ block.settings.label }}
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "350+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Outlets" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "stat", "settings": { "value": "350+", "label": "Outlets" } },
        { "type": "stat", "settings": { "value": "125+", "label": "Cities" } },
        { "type": "stat", "settings": { "value": "7 min", "label": "Live cakes" } }
      ]
    }
  ]
}
{% endschema %}