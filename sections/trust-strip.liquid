<section class="full-width bg-sh-brown text-white">
  <div class="mx-auto flex max-w-7xl flex-wrap justify-around gap-6 px-4 py-8 text-center sm:px-6 lg:px-8">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <strong class="block text-3xl font-bold">{{ block.settings.value }}</strong>
        <span class="text-sm text-white/90">{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "350+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Outlets" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "stat", "settings": { "value": "350+", "label": "Outlets" } },
        { "type": "stat", "settings": { "value": "125+", "label": "Cities" } },
        { "type": "stat", "settings": { "value": "7 min", "label": "Live cakes" } }
      ]
    }
  ]
}
{% endschema %}