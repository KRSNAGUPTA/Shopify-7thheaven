<section class="full-width py-12 md:py-16">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center">
      <h1 class="mb-2">{{ section.settings.heading }}</h1>
      {% if section.settings.pitch != blank %}
        <div class="text-left text-sh-text-light">
          {{ section.settings.pitch }}
        </div>
      {% endif %}
    </div>

    {% form 'contact', id: 'sh-franchise-form' %}
      {% if form.posted_successfully? %}
        <p class="rounded-lg bg-[#e6f4ea] px-4 py-3 font-semibold text-[#1b6b36]">
          {{ 'franchise.success' | t }}
        </p>
      {% endif %}

      {% if form.errors %}
        <div class="mb-4 rounded-lg bg-[#fdecea] px-4 py-3 text-[#a12a1f]">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <input type="hidden" name="contact[subject]" value="Franchise enquiry">
      <input type="hidden" name="contact[tags]" value="franchise">

      <div class="mt-6">
        <label for="franchise-name" class="mb-2 block font-semibold text-sh-brown">{{ 'franchise.name' | t }}</label>
        <input id="franchise-name" type="text" name="contact[name]" required value="{{ form.name }}" class="w-full rounded-lg border border-sh-border px-4 py-3">
      </div>

      <div class="mt-6">
        <label for="franchise-email" class="mb-2 block font-semibold text-sh-brown">{{ 'franchise.email' | t }}</label>
        <input id="franchise-email" type="email" name="contact[email]" required value="{{ form.email }}" class="w-full rounded-lg border border-sh-border px-4 py-3">
      </div>

      <div class="mt-6">
        <label for="franchise-phone" class="mb-2 block font-semibold text-sh-brown">{{ 'franchise.phone' | t }}</label>
        <input id="franchise-phone" type="tel" name="contact[phone]" required class="w-full rounded-lg border border-sh-border px-4 py-3">
      </div>

      <div class="mt-6">
        <label for="franchise-city" class="mb-2 block font-semibold text-sh-brown">{{ 'franchise.city' | t }}</label>
        <input id="franchise-city" type="text" name="contact[City]" required class="w-full rounded-lg border border-sh-border px-4 py-3">
      </div>

      <div class="mt-6">
        <label for="franchise-message" class="mb-2 block font-semibold text-sh-brown">{{ 'franchise.message' | t }}</label>
        <textarea id="franchise-message" name="contact[body]" rows="4" required class="w-full rounded-lg border border-sh-border px-4 py-3">{{ form.body }}</textarea>
      </div>

      <button type="submit" class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-sh-accent px-6 py-3 font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#b8234c] hover:shadow-md active:scale-95">
        {{ 'franchise.submit' | t }}
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Franchise form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Own a franchise"
    },
    {
      "type": "richtext",
      "id": "pitch",
      "label": "Pitch",
      "default": "<p>Partner with 7th Heaven and bring fresh cakes to your city. Share your details and our franchise team will reach out.</p>"
    }
  ],
  "presets": [{ "name": "Franchise form" }]
}
{% endschema %}
