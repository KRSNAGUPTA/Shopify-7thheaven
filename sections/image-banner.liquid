<section
  class="full-width bg-gradient-to-br from-sh-cream to-[#fef3ed] px-4 py-16 text-center md:py-24"
  style="{% if section.settings.image != blank %}background-image: linear-gradient(rgba(59,42,32,0.5), rgba(59,42,32,0.5)), url({{ section.settings.image | image_url: width: 2000 }}); background-size: cover; background-position: center;{% endif %}"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    {% if section.settings.heading != blank %}
      <h1 class="mb-4 {% if section.settings.image != blank %}text-white{% else %}text-sh-brown{% endif %}">
        {{ section.settings.heading }}
      </h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="mb-8 text-lg {% if section.settings.image != blank %}text-sh-accent-light{% else %}text-sh-text-light{% endif %}">
        {{ section.settings.subheading }}
      </p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link | default: '/collections/cakes' }}"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-sh-accent px-6 py-3 font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#b8234c] hover:shadow-md active:scale-95"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh cakes in 7 minutes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Order for same-day delivery in Andheri & Thane"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop cakes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
