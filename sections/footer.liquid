<footer class="full-width mt-12 bg-sh-brown text-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h4 class="mb-4 text-lg font-bold text-white">7th Heaven</h4>
        <p class="text-sm leading-relaxed text-gray-300">
          {{ 'footer.about_text' | t }}
        </p>
      </div>

      <div>
        <h4 class="mb-4 text-lg font-bold text-white">{{ 'general.nav.cakes' | t }}</h4>
        <a href="{{ routes.collections_url }}/cakes" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'general.nav.cakes' | t }}</a>
        <a href="{{ routes.collections_url }}/cupcakes" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'general.nav.cupcakes' | t }}</a>
        <a href="{{ routes.collections_url }}/desserts" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'general.nav.desserts' | t }}</a>
      </div>

      <div>
        <h4 class="mb-4 text-lg font-bold text-white">{{ 'footer.help' | t }}</h4>
        <a href="/pages/stores" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'general.nav.stores' | t }}</a>
        <a href="/pages/franchise" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'general.nav.franchise' | t }}</a>
        <a href="/policies/privacy-policy" class="mb-2 block text-sm text-gray-300 transition-colors hover:text-sh-accent">{{ 'footer.privacy' | t }}</a>
      </div>

      <div>
        <h4 class="mb-4 text-lg font-bold text-white">{{ 'footer.connect' | t }}</h4>
        <p class="mb-4 text-sm text-gray-300">cs@7thheaven.in</p>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center text-xs text-gray-400">
      <p class="m-0">
        © {{ 'now' | date: '%Y' }} 7th Heaven.
        <a href="/policies/privacy-policy" class="mx-2 inline text-gray-400 transition-colors hover:text-sh-accent">{{ 'footer.privacy' | t }}</a>
        <a href="/policies/terms-of-service" class="mx-2 inline text-gray-400 transition-colors hover:text-sh-accent">{{ 'footer.terms' | t }}</a>
        <a href="/policies/refund-policy" class="mx-2 inline text-gray-400 transition-colors hover:text-sh-accent">{{ 'footer.refund' | t }}</a>
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
