<footer class="w-full bg-[#3d2419] text-white mt-12 md:mt-16 border-t border-white/10 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Main Footer Links Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-10 pb-8 md:pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand Info & About -->
      <div class="space-y-4 sm:col-span-2 md:col-span-3 lg:col-span-2">
        {% if section.settings.footer_logo != blank %}
          <a href="{{ routes.root_url }}" class="inline-block">
            <img
              src="{{ section.settings.footer_logo | image_url: width: 180 }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ section.settings.footer_logo.width }}"
              height="{{ section.settings.footer_logo.height }}"
              class="h-9 md:h-10 w-auto object-contain"
            >
          </a>
        {% else %}
          <h3 class="text-lg md:text-xl font-extrabold text-white tracking-tight">
            {{ shop.name }}
          </h3>
        {% endif %}

        <p class="text-sm text-gray-300 leading-relaxed max-w-sm">
          {{ section.settings.about_text }}
        </p>

        <!-- Social Links -->
        {% if section.settings.show_socials %}
          <div class="pt-1 flex items-center gap-3 text-gray-300">
            {% if settings.social_instagram_link != blank %}
              <a
                href="{{ settings.social_instagram_link }}"
                target="_blank"
                rel="noopener"
                class="p-2 -ml-2 hover:text-amber-400 transition-colors"
                aria-label="Instagram"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            {% endif %}
            {% if settings.social_facebook_link != blank %}
              <a
                href="{{ settings.social_facebook_link }}"
                target="_blank"
                rel="noopener"
                class="p-2 hover:text-amber-400 transition-colors"
                aria-label="Facebook"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Column 2: Categories / Menu 1 -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">
          {{ section.settings.menu_1_heading | default: 'Categories' }}
        </h4>
        <ul class="space-y-2">
          {% if section.settings.menu_1 != blank %}
            {% for link in section.settings.menu_1.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
                >
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          {% else %}
            <li>
              <a
                href="{{ routes.collections_url }}/cakes"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                {{- 'general.nav.cakes' | t: default: 'Cakes' -}}
              </a>
            </li>
            <li>
              <a
                href="{{ routes.collections_url }}/cupcakes"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                {{- 'general.nav.cupcakes' | t: default: 'Cupcakes' -}}
              </a>
            </li>
            <li>
              <a
                href="{{ routes.collections_url }}/desserts"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                {{- 'general.nav.desserts' | t: default: 'Desserts' -}}
              </a>
            </li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 3: Quick Links / Menu 2 -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">
          {{ section.settings.menu_2_heading | default: 'Quick Links' }}
        </h4>
        <ul class="space-y-2">
          {% if section.settings.menu_2 != blank %}
            {% for link in section.settings.menu_2.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
                >
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          {% else %}
            <li>
              <a
                href="/pages/stores"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                {{- 'general.nav.stores' | t: default: 'Stores' -}}
              </a>
            </li>
            <li>
              <a
                href="/pages/franchise"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                {{- 'general.nav.franchise' | t: default: 'Franchise' -}}
              </a>
            </li>
            <li>
              <a
                href="/policies/privacy-policy"
                class="text-sm text-gray-300 hover:text-amber-400 transition-colors inline-block py-0.5"
              >
                Privacy Policy
              </a>
            </li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 4: Support & Connect -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">Connect</h4>
        <div class="space-y-2 text-sm">
          {% if section.settings.contact_email != blank %}
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a 
                href="mailto:{{ section.settings.contact_email }}" 
                style="color: #fb923c;" 
                class="hover:opacity-80 transition-opacity break-all sm:break-normal"
              >
                {{ section.settings.contact_email }}
              </a>
            </p>
          {% endif %}

          {% if section.settings.contact_phone != blank %}
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <a
                href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}"
                style="color: #fb923c;"
                class="hover:opacity-80 transition-opacity whitespace-nowrap"
              >
                {{ section.settings.contact_phone }}
              </a>
            </p>
          {% endif %}
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 md:pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <p class="text-center sm:text-left order-2 sm:order-1">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 order-1 sm:order-2" style="color: #fb923c;">
        <a href="/policies/privacy-policy" style="color: inherit;" class="hover:opacity-80 transition-opacity">Privacy Policy</a>
        <a href="/policies/terms-of-service" style="color: inherit;" class="hover:opacity-80 transition-opacity">Terms of Service</a>
        <a href="/policies/refund-policy" style="color: inherit;" class="hover:opacity-80 transition-opacity">Refund Policy</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo Image"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "India's premier cake and dessert chain offering live fresh bakery products."
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Menu 1 Heading",
      "default": "Categories"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Linklist"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Menu 2 Heading",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 Linklist"
    },
    {
      "type": "header",
      "content": "Customer Support"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "cs@7thheaven.in"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone Number",
      "default": "+91 96198 97353"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show Social Icons",
      "default": true
    }
  ]
}
{% endschema %}