<!-- Footer -->
<footer class="sh-footer">
  <div class="sh-container">
    <div class="sh-grid sh-grid--4col" style="color: white; margin-bottom: 2rem;">
      <div class="sh-footer-section">
        <h4 class="sh-footer-title">7th Heaven</h4>
        <p style="font-size: 0.95rem; line-height: 1.6; color: #ccc;">
          Fresh cakes made in 7 minutes. Delivering across Andheri and Thane for this MVP.
        </p>
      </div>

      <div class="sh-footer-section">
        <h4 class="sh-footer-title">{{ 'general.nav.cakes' | t }}</h4>
        <a href="{{ routes.collections_url }}/cakes" class="sh-footer-link">{{ 'general.nav.cakes' | t }}</a>
        <a href="{{ routes.collections_url }}/cupcakes" class="sh-footer-link">{{ 'general.nav.cupcakes' | t }}</a>
        <a href="{{ routes.collections_url }}/desserts" class="sh-footer-link">{{ 'general.nav.desserts' | t }}</a>
      </div>

      <div class="sh-footer-section">
        <h4 class="sh-footer-title">Help</h4>
        <a href="/pages/stores" class="sh-footer-link">{{ 'general.nav.stores' | t }}</a>
        <a href="/pages/franchise" class="sh-footer-link">{{ 'general.nav.franchise' | t }}</a>
        <a href="/policies/privacy-policy" class="sh-footer-link">Privacy</a>
      </div>

      <div class="sh-footer-section">
        <h4 class="sh-footer-title">Connect</h4>
        <p style="font-size: 0.95rem; color: #ccc; margin-bottom: 1rem;">
          cs@7thheaven.in
        </p>
      </div>
    </div>

    <div class="sh-footer-bottom">
      <p style="margin: 0;">
        © {{ 'now' | date: '%Y' }} 7th Heaven.
        <a href="/policies/privacy-policy" class="sh-footer-link" style="display: inline; margin: 0 0.5rem;">Privacy</a>
        <a href="/policies/terms-of-service" class="sh-footer-link" style="display: inline; margin: 0 0.5rem;">Terms</a>
        <a href="/policies/refund-policy" class="sh-footer-link" style="display: inline; margin: 0 0.5rem;">Refund</a>
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
