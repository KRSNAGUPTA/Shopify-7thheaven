{%- comment -%}
  Footer — fully Shopify-driven
  - Logo: section image → Shopify brand square logo → brand logo → shop name
  - Link columns: add/remove as blocks, each linked to a Shopify menu
  - Policies: pulled from Settings → Policies (only ones that exist)
  - Payment icons: pulled from Settings → Payments
  - Contact: section value → shop email
{%- endcomment -%}

{%- assign footer_logo = section.settings.logo | default: shop.brand.square_logo | default: shop.brand.logo -%}
{%- assign contact_email = section.settings.contact_email | default: shop.email -%}
{%- assign contact_phone = section.settings.contact_phone -%}

{%- assign instagram = section.settings.instagram_url | default: settings.social_instagram_link -%}
{%- assign facebook = section.settings.facebook_url | default: settings.social_facebook_link -%}
{%- assign youtube = section.settings.youtube_url | default: settings.social_youtube_link -%}
{%- assign twitter = section.settings.x_url | default: settings.social_twitter_link -%}

{%- assign link_class = 'inline-block py-1 text-sm text-sh-cream/80 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary rounded' -%}
{%- assign social_class = 'inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-sh-cream transition-colors hover:bg-white/10 hover:text-white active:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary' -%}

<footer class="mt-12 w-full border-t border-white/10 bg-sh-brown-dark font-body text-white md:mt-16">
  <div class="mx-auto max-w-7xl px-5 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-16">

    <div class="grid grid-cols-1 gap-10 border-b border-white/10 pb-10 lg:grid-cols-12 lg:gap-12 lg:pb-14">

      {%- comment -%}Brand{%- endcomment -%}
      <div class="lg:col-span-4">
        <a
          href="{{ routes.root_url }}"
          class="inline-flex items-center gap-3 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        >
          {%- if footer_logo != blank -%}
            {%- assign logo_w = section.settings.logo_width -%}
            {%- assign logo_h = logo_w | divided_by: footer_logo.aspect_ratio | round -%}
            {{
              footer_logo
              | image_url: width: 400
              | image_tag:
                width: logo_w,
                height: logo_h,
                loading: 'lazy',
                class: 'h-auto w-auto max-w-full object-contain',
                style: 'width:' | append: logo_w | append: 'px',
                alt: shop.name | escape
            }}
          {%- endif -%}
          {%- if footer_logo == blank or section.settings.show_shop_name -%}
            <span class="font-sniglet text-2xl font-medium leading-none tracking-[-0.01em] text-white">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.about_text != blank -%}
          <p class="mt-4 max-w-sm text-sm leading-[1.65] text-sh-cream/80 [text-wrap:pretty]">
            {{ section.settings.about_text }}
          </p>
        {%- endif -%}

        {%- if section.settings.show_socials and instagram != blank or facebook != blank or youtube != blank or twitter != blank -%}
          {%- if section.settings.show_socials -%}
            <ul class="mt-5 flex items-center gap-2">
              {%- if instagram != blank -%}
                <li>
                  <a href="{{ instagram }}" target="_blank" rel="noopener" class="{{ social_class }}" aria-label="Instagram">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if facebook != blank -%}
                <li>
                  <a href="{{ facebook }}" target="_blank" rel="noopener" class="{{ social_class }}" aria-label="Facebook">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/></svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if youtube != blank -%}
                <li>
                  <a href="{{ youtube }}" target="_blank" rel="noopener" class="{{ social_class }}" aria-label="YouTube">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if twitter != blank -%}
                <li>
                  <a href="{{ twitter }}" target="_blank" rel="noopener" class="{{ social_class }}" aria-label="X">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%}Link columns (blocks) + contact{%- endcomment -%}
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-8 lg:gap-x-8">
        {%- for block in section.blocks -%}
          {%- if block.settings.menu != blank -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-sh-primary">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              <ul class="mt-3 space-y-1 sm:mt-4">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %} class="{{ link_class }}">
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if contact_email != blank or contact_phone != blank -%}
          <div class="col-span-2 sm:col-span-1">
            {%- if section.settings.contact_heading != blank -%}
              <h2 class="text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-sh-primary">
                {{ section.settings.contact_heading }}
              </h2>
            {%- endif -%}
            <ul class="mt-3 space-y-3 sm:mt-4">
              {%- if contact_email != blank -%}
                <li>
                  <a href="mailto:{{ contact_email }}" class="group inline-flex items-start gap-2.5 rounded text-sm text-sh-cream/80 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-sh-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span class="break-all">{{ contact_email }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if contact_phone != blank -%}
                <li>
                  <a href="tel:{{ contact_phone | remove: ' ' }}" class="group inline-flex items-start gap-2.5 rounded text-sm text-sh-cream/80 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-sh-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <span class="whitespace-nowrap">{{ contact_phone }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}Bottom bar{%- endcomment -%}
    <div class="flex flex-col items-center gap-5 pt-6 text-xs text-sh-cream/60 md:pt-8 lg:flex-row lg:justify-between">
      <p class="order-3 text-center lg:order-1 lg:text-left">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>

      {%- if shop.policies.size > 0 -%}
        <ul class="order-1 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 lg:order-2">
          {%- for policy in shop.policies -%}
            <li>
              <a href="{{ policy.url }}" class="inline-block rounded py-1 text-sh-cream/80 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary">
                {{ policy.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="order-2 flex flex-wrap items-center justify-center gap-1.5 lg:order-3" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Brand" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / icon",
      "info": "Leave empty to use the logo from Shopify's brand settings (Settings → Brand)."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 240,
      "step": 10,
      "default": 56,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "Show shop name next to logo",
      "info": "Useful when the logo is an icon only.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "India's premier cake and dessert chain offering live fresh bakery products."
    },
    { "type": "header", "content": "Contact" },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Connect"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "info": "Leave empty to use the store email from Settings → Store details."
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "+91 96198 97353"
    },
    { "type": "header", "content": "Social" },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram",
      "info": "Falls back to the theme's social settings if empty."
    },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "x_url", "label": "X (Twitter)" },
    { "type": "header", "content": "Bottom bar" },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "info": "Uses the payment methods enabled in Shopify.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Categories" } },
        { "type": "link_list", "settings": { "heading": "Quick links" } }
      ]
    }
  ]
}
{% endschema %}