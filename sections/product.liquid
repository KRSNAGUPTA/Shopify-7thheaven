{%- comment -%}
  Product page
  Layout: Gallery | Title → Price → Chips → Options → Personalise → Qty + Total → CTAs → Details
  Everything (price, total, image, availability, buttons, sticky bar) updates from one render() in the JS
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign prep = product.metafields.custom.prep_time_hours.value | default: product.metafields.custom.prep_hours.value -%}
{%- assign serves = product.metafields.custom.serves.value -%}
{%- assign max_qty = section.settings.max_quantity | default: 10 -%}
{%- assign suggestions = section.settings.message_suggestions | split: ',' -%}
{%- assign start_media = current_variant.featured_media | default: product.featured_media -%}

{%- assign image_count = 0 -%}
{%- for media in product.media -%}
  {%- if media.media_type == 'image' -%}
    {%- assign image_count = image_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign has_discount = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign has_discount = true -%}
  {%- assign saved_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
{%- endif -%}

<section
  id="sh-product"
  class="w-ful pb-28 pt-6 font-body sm:pt-10 lg:pb-24 lg:pt-14"
  data-initial-variant="{{ current_variant.id }}"
  data-max-qty="{{ max_qty }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-default-only="{{ product.has_only_default_variant }}"
  data-title="{{ product.title | escape }}"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-14">

      {%- comment -%}Gallery{%- endcomment -%}
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="relative mx-auto aspect-square w-full max-w-md overflow-hidden sm:max-w-none">
          {%- if start_media -%}
            <img
              id="sh-main-image"
              src="{{ start_media.preview_image | image_url: width: 1200 }}"
              alt="{{ start_media.alt | default: product.title | escape }}"
              width="{{ start_media.preview_image.width }}"
              height="{{ start_media.preview_image.height }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-contain p-4 transition-opacity duration-200 sm:p-6"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-contain p-12 text-sh-border' }}
          {%- endif -%}

          <span
            data-soldout-badge
            class="absolute left-3 top-3 z-10 rounded-full bg-black/70 px-3 py-1.5 text-[0.65rem] font-bold uppercase tracking-widest text-white backdrop-blur-md {% if current_variant.available %}hidden{% endif %}"
          >
            Sold out
          </span>
        </div>

        {%- if image_count > 1 -%}
          <div class="sh-pdp-scroll mt-3 flex gap-2 overflow-x-auto pb-1">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button
                  type="button"
                  data-thumb
                  data-media-id="{{ media.id }}"
                  data-src="{{ media.preview_image | image_url: width: 1200 }}"
                  data-alt="{{ media.alt | default: product.title | escape }}"
                  aria-label="View image {{ forloop.index }}"
                  class="h-16 w-16 shrink-0 cursor-pointer overflow-hidden rounded-xl border-2 bg-sh-cream-light transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary {% if media.id == start_media.id %}border-sh-primary{% else %}border-transparent hover:border-sh-border{% endif %}"
                >
                  {{ media.preview_image | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy', alt: '' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}Info{%- endcomment -%}
      <div class="flex flex-col">

        {%- if product.type != blank -%}
          <p class="text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-sh-primary-dark">{{ product.type }}</p>
        {%- endif -%}

        <h1 class="{% if product.type != blank %}mt-2 {% endif %}font-sniglet text-[1.75rem] font-medium leading-[1.1] tracking-[-0.02em] text-sh-brown [text-wrap:balance] sm:text-4xl lg:text-[2.5rem]">
          {{ product.title | escape }}
        </h1>

        {%- comment -%}Price (per item){%- endcomment -%}
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span data-price class="font-sniglet text-[1.875rem] leading-none text-sh-primary-dark sm:text-4xl">
            {{- current_variant.price | money -}}
          </span>
          <s data-compare class="text-base text-sh-text-light {% unless has_discount %}hidden{% endunless %}">
            {%- if has_discount -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
          </s>
          <span data-save class="rounded-full bg-sh-primary-light px-2.5 py-1 text-xs font-semibold text-sh-primary-dark {% unless has_discount %}hidden{% endunless %}">
            {%- if has_discount -%}{{ saved_pct }}% off{%- endif -%}
          </span>
        </div>

        {%- comment -%}Serves / prep chips{%- endcomment -%}
        {%- if serves != blank or prep != blank -%}
          <ul class="mt-4 flex flex-wrap gap-2">
            {%- if serves != blank -%}
              <li class="inline-flex items-center gap-1.5 rounded-full bg-sh-cream-light px-3 py-1.5 text-xs font-medium text-sh-text-light sm:text-sm">
                <svg class="h-4 w-4 shrink-0 text-sh-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5.13a4 4 0 11-8 0 4 4 0 018 0zm6 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                <span>Serves <strong class="font-semibold text-sh-brown">{{ serves }}</strong></span>
              </li>
            {%- endif -%}
            {%- if prep != blank -%}
              <li class="inline-flex items-center gap-1.5 rounded-full bg-sh-cream-light px-3 py-1.5 text-xs font-medium text-sh-text-light sm:text-sm">
                <svg class="h-4 w-4 shrink-0 text-sh-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Ready in <strong class="font-semibold text-sh-brown">{{ prep }} hrs</strong></span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {% form 'product', product, id: 'sh-product-form', class: 'mt-7 border-t border-sh-border pt-6' %}
          <input type="hidden" name="id" id="sh-variant-id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="sh-qty-input" value="1">

          {%- comment -%}Options (all rendered as pills){%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="space-y-6">
              {%- for option in product.options_with_values -%}
                {%- assign idx = forloop.index0 -%}
                {%- assign selected_value = current_variant.options[idx] -%}
                <div>
                  <p id="sh-opt-label-{{ idx }}" class="mb-3 text-sm font-semibold text-sh-brown">
                    {{ option.name }}<span class="font-normal text-sh-text-light" data-option-selected="{{ idx }}">: {{ selected_value }}</span>
                  </p>
                  <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="sh-opt-label-{{ idx }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        role="radio"
                        data-option-btn
                        data-option-index="{{ idx }}"
                        data-value="{{ value | escape }}"
                        aria-checked="{% if value == selected_value %}true{% else %}false{% endif %}"
                        class="cursor-pointer rounded-full border px-4 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 active:scale-[0.97] {% if value == selected_value %}border-sh-primary bg-sh-primary text-white{% else %}border-sh-border bg-white text-sh-brown hover:border-sh-primary{% endif %}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- comment -%}Personalise{%- endcomment -%}
          {%- if section.settings.show_message_field -%}
            <div class="{% unless product.has_only_default_variant %}mt-7{% endunless %}">
              <div class="mb-2 flex items-baseline justify-between gap-3">
                <label for="sh-cake-message" class="text-sm font-semibold text-sh-brown">
                  Message on cake <span class="font-normal text-sh-text-light">(optional)</span>
                </label>
                <span class="text-xs tabular-nums text-sh-text-light" data-count>0/30</span>
              </div>
              <input
                type="text"
                name="properties[Message on cake]"
                id="sh-cake-message"
                maxlength="30"
                autocomplete="off"
                placeholder="e.g. Happy Birthday Vaishnavi!"
                class="w-full rounded-xl border border-sh-border bg-white px-4 py-3 text-base text-sh-brown placeholder:text-sh-text-light/60 focus:border-sh-primary focus:outline-none focus:ring-2 focus:ring-sh-primary/40"
              >
              {%- if suggestions.size > 0 -%}
                <div class="mt-2 flex flex-wrap gap-2">
                  {%- for suggestion in suggestions -%}
                    {%- assign s = suggestion | strip -%}
                    {%- if s != blank -%}
                      <button
                        type="button"
                        data-suggestion="{{ s | escape }}"
                        class="cursor-pointer rounded-full border border-sh-border bg-sh-cream-light px-3 py-1.5 text-xs font-medium text-sh-text-light transition-colors hover:border-sh-primary hover:text-sh-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
                      >
                        {{ s }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_instructions_field -%}
            <details class="group mt-5">
              <summary class="flex cursor-pointer list-none items-center gap-2 rounded text-sm font-semibold text-sh-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary [&::-webkit-details-marker]:hidden">
                Add special instructions
                <svg class="h-4 w-4 text-sh-text-light transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <textarea
                name="properties[Special instructions]"
                id="sh-instructions"
                rows="2"
                maxlength="200"
                placeholder="Allergies, delivery notes…"
                class="mt-3 min-h-16 w-full resize-y rounded-xl border border-sh-border bg-white px-4 py-3 text-base text-sh-brown placeholder:text-sh-text-light/60 focus:border-sh-primary focus:outline-none focus:ring-2 focus:ring-sh-primary/40"
              ></textarea>
            </details>
          {%- endif -%}

          {%- comment -%}Quantity + live total + CTAs{%- endcomment -%}
          <div id="sh-cta" class="mt-7 border-t border-sh-border pt-6">
            <div class="flex items-center justify-between gap-4">
              <div class="inline-flex items-center overflow-hidden rounded-full border border-sh-border bg-white" role="group" aria-label="Quantity">
                <button
                  type="button"
                  data-qty-step="-1"
                  aria-label="Decrease quantity"
                  disabled
                  class="inline-flex h-11 w-11 cursor-pointer items-center justify-center text-sh-brown transition-colors hover:bg-sh-cream-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                </button>
                <span class="w-10 text-center text-base font-semibold tabular-nums text-sh-brown" data-qty-value aria-live="polite">1</span>
                <button
                  type="button"
                  data-qty-step="1"
                  aria-label="Increase quantity"
                  class="inline-flex h-11 w-11 cursor-pointer items-center justify-center text-sh-brown transition-colors hover:bg-sh-cream-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </button>
              </div>

              <div class="text-right">
                <p class="text-xs text-sh-text-light" data-total-caption>Total</p>
                <p class="font-sniglet text-2xl leading-tight text-sh-brown sm:text-[1.75rem]" data-total>{{ current_variant.price | money }}</p>
              </div>
            </div>

            <p id="sh-product-error" class="mt-4 hidden rounded-lg bg-sh-error/10 px-3 py-2 text-sm font-semibold text-sh-error" role="alert"></p>

            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
              <button
                type="submit"
                id="sh-add-to-cart"
                data-cta="add"
                class="inline-flex flex-1 cursor-pointer items-center justify-center rounded-full bg-sh-primary px-6 py-4 text-base font-semibold text-white transition-all hover:bg-sh-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-cta-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
              </button>
              <button
                type="submit"
                id="sh-buy-now"
                data-cta="buy"
                class="inline-flex flex-1 cursor-pointer items-center justify-center rounded-full border-2 border-sh-brown-dark bg-transparent px-6 py-4 text-base font-semibold text-sh-brown-dark transition-all hover:bg-sh-brown-dark hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-cta-label>{% if current_variant.available %}Buy now{% else %}Sold out{% endif %}</span>
              </button>
            </div>
          </div>
        {% endform %}

        {%- comment -%}Description{%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="mt-8 border-t border-sh-border pt-6">
            <h2 class="text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-sh-primary-dark">Details</h2>
            <div class="mt-3 text-[0.95rem] leading-[1.7] text-sh-text-light [text-wrap:pretty] sm:text-base [&_a]:text-sh-primary-dark [&_a]:underline [&_a]:underline-offset-4 [&_li]:mt-1 [&_p]:mt-3 [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_strong]:text-sh-brown [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5">
              {{ product.description }}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}Mobile sticky buy bar (appears when the main buttons scroll out of view){%- endcomment -%}
  <div
    id="sh-sticky-bar"
    class="pointer-events-none fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-sh-border bg-white/95 backdrop-blur-xl transition-transform duration-300 lg:hidden"
    style="padding-bottom: env(safe-area-inset-bottom, 0px);"
    aria-hidden="true"
  >
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-5 py-3 sm:px-6">
      <div class="min-w-0 flex-1">
        <p class="truncate text-xs text-sh-text-light" data-bar-summary></p>
        <p class="font-sniglet text-xl leading-tight text-sh-primary-dark" data-total>{{ current_variant.price | money }}</p>
      </div>
      <button
        type="button"
        data-bar-add
        tabindex="-1"
        class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full bg-sh-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-sh-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span data-cta-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
      </button>
    </div>
  </div>

  <script type="application/json" id="sh-variants-data">
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available }},
          "media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Personalisation" },
    {
      "type": "checkbox",
      "id": "show_message_field",
      "label": "Show 'Message on cake' field",
      "default": true
    },
    {
      "type": "text",
      "id": "message_suggestions",
      "label": "Message suggestions",
      "info": "Comma-separated. Shown as tap-to-fill chips under the message field.",
      "default": "Happy Birthday!, Happy Anniversary!, Congratulations!"
    },
    {
      "type": "checkbox",
      "id": "show_instructions_field",
      "label": "Show 'Special instructions' field",
      "default": true
    },
    { "type": "header", "content": "Purchase" },
    {
      "type": "range",
      "id": "max_quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Max quantity per order"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .sh-pdp-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .sh-pdp-scroll::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    /* Class sets are written out in full so Tailwind's scanner picks them up */
    var ON = ['border-sh-primary', 'bg-sh-primary', 'text-white'];
    var OFF = ['border-sh-border', 'bg-white', 'text-sh-brown', 'hover:border-sh-primary'];
    var THUMB_ON = ['border-sh-primary'];
    var THUMB_OFF = ['border-transparent', 'hover:border-sh-border'];
    var BAR_SHOW = 'translate-y-0';
    var BAR_HIDE = 'translate-y-full';

    var observers = [];

    function swap(el, add, remove) {
      remove.forEach(function (c) { el.classList.remove(c); });
      add.forEach(function (c) { el.classList.add(c); });
    }

    /* Formats cents using the store's own money format, so it matches the product cards */
    function formatMoney(cents, format) {
      var fmt = format;
      var re = /\{\{\s*(\w+)\s*\}\}/;
      function withDelimiters(number, precision, thousands, decimal) {
        thousands = thousands || ',';
        decimal = decimal || '.';
        if (isNaN(number) || number == null) return '0';
        var fixed = (number / 100).toFixed(precision);
        var parts = fixed.split('.');
        var whole = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return parts[1] ? whole + decimal + parts[1] : whole;
      }
      var match = fmt.match(re);
      var key = match ? match[1] : 'amount';
      var value;
      switch (key) {
        case 'amount_no_decimals': value = withDelimiters(cents, 0); break;
        case 'amount_with_comma_separator': value = withDelimiters(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = withDelimiters(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': value = withDelimiters(cents, 2, "'", '.'); break;
        case 'amount_no_decimals_with_space_separator': value = withDelimiters(cents, 0, ' '); break;
        case 'amount_with_space_separator': value = withDelimiters(cents, 2, ' ', ','); break;
        default: value = withDelimiters(cents, 2);
      }
      return fmt.replace(re, value);
    }

    function init() {
      var root = document.getElementById('sh-product');
      if (!root || root.getAttribute('data-ready') === 'true') return;
      root.setAttribute('data-ready', 'true');

      observers.forEach(function (o) { o.disconnect(); });
      observers = [];

      var variants = [];
      try {
        variants = JSON.parse(document.getElementById('sh-variants-data').textContent);
      } catch (e) {}
      if (!variants.length) return;

      /* ---------- State ---------- */
      var initialId = parseInt(root.getAttribute('data-initial-variant'), 10);
      var initial =
        variants.filter(function (v) { return v.id === initialId; })[0] ||
        variants.filter(function (v) { return v.available; })[0] ||
        variants[0];

      var selected = initial.options.slice();
      var qty = 1;
      var maxQty = parseInt(root.getAttribute('data-max-qty'), 10) || 10;
      var moneyFmt = root.getAttribute('data-money-format');
      var defaultOnly = root.getAttribute('data-default-only') === 'true';
      var title = root.getAttribute('data-title') || '';
      var lastVariantId = null;
      var busy = false;
      var flash = '';
      var fromBar = false;
      var lastCta = 'add';

      function money(c) { return formatMoney(c, moneyFmt); }

      /* ---------- Elements ---------- */
      var form = document.getElementById('sh-product-form');
      var variantInput = document.getElementById('sh-variant-id');
      var qtyInput = document.getElementById('sh-qty-input');
      var errorEl = document.getElementById('sh-product-error');
      var mainImg = document.getElementById('sh-main-image');
      var priceEl = root.querySelector('[data-price]');
      var compareEl = root.querySelector('[data-compare]');
      var saveEl = root.querySelector('[data-save]');
      var totalEls = root.querySelectorAll('[data-total]');
      var captionEl = root.querySelector('[data-total-caption]');
      var summaryEl = root.querySelector('[data-bar-summary]');
      var soldBadge = root.querySelector('[data-soldout-badge]');
      var qtyValueEls = root.querySelectorAll('[data-qty-value]');
      var minusBtn = root.querySelector('[data-qty-step="-1"]');
      var plusBtn = root.querySelector('[data-qty-step="1"]');
      var optionBtns = Array.prototype.slice.call(root.querySelectorAll('[data-option-btn]'));
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-thumb]'));
      var addBtn = document.getElementById('sh-add-to-cart');
      var buyBtn = document.getElementById('sh-buy-now');
      var bar = document.getElementById('sh-sticky-bar');
      var barBtn = root.querySelector('[data-bar-add]');
      var msgInput = document.getElementById('sh-cake-message');
      var counterEl = root.querySelector('[data-count]');

      /* ---------- Variant lookup ---------- */
      function exact(sel) {
        return variants.filter(function (v) {
          return v.options.every(function (o, i) { return String(o) === String(sel[i]); });
        })[0] || null;
      }

      function current() { return exact(selected); }

      /* Picks the closest real variant when a chosen value doesn't exist with the current other choices */
      function bestFor(idx, val) {
        var best = null;
        var bestScore = -1;
        variants.forEach(function (v) {
          if (String(v.options[idx]) !== String(val)) return;
          var score = 0;
          v.options.forEach(function (o, i) {
            if (i !== idx && String(o) === String(selected[i])) score++;
          });
          if (v.available) score += 0.5;
          if (score > bestScore) { best = v; bestScore = score; }
        });
        return best;
      }

      /* ---------- Gallery ---------- */
      function setImage(src, alt) {
        if (!mainImg || !src) return;

        /* Same image — nothing to swap, but make sure opacity isn't stuck */
        if (mainImg.getAttribute('src') === src) {
          mainImg.classList.remove('opacity-0');
          return;
        }

        mainImg.classList.add('opacity-0');
        var pre = new Image();
        var done = function () {
          mainImg.src = src;
          mainImg.alt = alt || '';
          /* Force reflow so removing opacity-0 triggers the CSS transition */
          void mainImg.offsetWidth;
          mainImg.classList.remove('opacity-0');
        };
        pre.onload = done;
        pre.onerror = done;
        pre.src = src;
      }

      function selectThumb(thumb) {
        thumbs.forEach(function (t) {
          var on = t === thumb;
          swap(t, on ? THUMB_ON : THUMB_OFF, on ? THUMB_OFF : THUMB_ON);
          if (on) t.setAttribute('aria-current', 'true');
          else t.removeAttribute('aria-current');
        });
        setImage(thumb.getAttribute('data-src'), thumb.getAttribute('data-alt'));
      }

      /* ---------- Render: single source of truth for the UI ---------- */
      function render() {
        var v = current();
        if (!v) return;

        if (variantInput) variantInput.value = v.id;
        if (qtyInput) qtyInput.value = qty;

        /* Unit price + discount */
        if (priceEl) priceEl.innerHTML = money(v.price);
        var onSale = v.compare_at_price && v.compare_at_price > v.price;
        if (compareEl) {
          compareEl.innerHTML = onSale ? money(v.compare_at_price) : '';
          compareEl.classList.toggle('hidden', !onSale);
        }
        if (saveEl) {
          saveEl.textContent = onSale
            ? Math.round(((v.compare_at_price - v.price) / v.compare_at_price) * 100) + '% off'
            : '';
          saveEl.classList.toggle('hidden', !onSale);
        }

        /* Quantity-aware total */
        var total = money(v.price * qty);
        Array.prototype.forEach.call(totalEls, function (el) { el.innerHTML = total; });
        if (captionEl) captionEl.innerHTML = qty > 1 ? qty + ' × ' + money(v.price) : 'Total';
        Array.prototype.forEach.call(qtyValueEls, function (el) { el.textContent = qty; });
        if (minusBtn) minusBtn.disabled = qty <= 1;
        if (plusBtn) plusBtn.disabled = qty >= maxQty;

        /* Option pills: selected, sold-out and non-existent combinations */
        optionBtns.forEach(function (btn) {
          var idx = parseInt(btn.getAttribute('data-option-index'), 10);
          var val = btn.getAttribute('data-value');
          var isSel = String(selected[idx]) === String(val);

          swap(btn, isSel ? ON : OFF, isSel ? OFF : ON);
          btn.setAttribute('aria-checked', isSel ? 'true' : 'false');

          var cand = selected.slice();
          cand[idx] = val;
          var m = exact(cand);
          btn.classList.toggle('opacity-50', !isSel && (!m || !m.available));
          btn.classList.toggle('line-through', !isSel && !!m && !m.available);
        });

        Array.prototype.forEach.call(root.querySelectorAll('[data-option-selected]'), function (el) {
          el.textContent = ': ' + selected[parseInt(el.getAttribute('data-option-selected'), 10)];
        });

        /* Availability + labels */
        var addLabel = busy ? '…' : flash || (v.available ? 'Add to cart' : 'Sold out');
        var buyLabel = busy ? '…' : v.available ? 'Buy now' : 'Sold out';
        var lock = busy || !v.available;

        [[addBtn, addLabel], [buyBtn, buyLabel], [barBtn, addLabel]].forEach(function (pair) {
          var btn = pair[0];
          if (!btn) return;
          btn.disabled = lock;
          var label = btn.querySelector('[data-cta-label]');
          if (label) label.textContent = pair[1];
        });
        if (soldBadge) soldBadge.classList.toggle('hidden', v.available);

        /* Sticky bar summary */
        if (summaryEl) {
          summaryEl.textContent = (defaultOnly ? title : selected.join(' · ')) + (qty > 1 ? ' × ' + qty : '');
        }

        /* Variant changed: sync gallery + URL */
        if (lastVariantId !== null && v.id !== lastVariantId) {
          var thumb = null;
          if (v.media_id) {
            thumb = thumbs.filter(function (t) {
              return t.getAttribute('data-media-id') === String(v.media_id);
            })[0];
          }
          /* No variant-specific image → revert to the first gallery image */
          if (!thumb && thumbs.length) {
            thumb = thumbs[0];
          }
          if (thumb) {
            selectThumb(thumb);
          }
          try {
            var u = new URL(window.location.href);
            u.searchParams.set('variant', v.id);
            window.history.replaceState({}, '', u.toString());
          } catch (e) {}
        }
        lastVariantId = v.id;
      }

      /* ---------- Clicks (delegated) ---------- */
      root.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;

        var optBtn = t.closest('[data-option-btn]');
        if (optBtn) {
          var next = bestFor(parseInt(optBtn.getAttribute('data-option-index'), 10), optBtn.getAttribute('data-value'));
          if (next) { selected = next.options.slice(); render(); }
          return;
        }

        var thumb = t.closest('[data-thumb]');
        if (thumb) { selectThumb(thumb); return; }

        var step = t.closest('[data-qty-step]');
        if (step) {
          var delta = parseInt(step.getAttribute('data-qty-step'), 10) || 0;
          qty = Math.min(maxQty, Math.max(1, qty + delta));
          render();
          return;
        }

        var chip = t.closest('[data-suggestion]');
        if (chip && msgInput) {
          msgInput.value = chip.getAttribute('data-suggestion').slice(0, msgInput.maxLength);
          msgInput.dispatchEvent(new Event('input', { bubbles: true }));
          msgInput.focus();
          return;
        }

        var cta = t.closest('[data-cta]');
        if (cta) { lastCta = cta.getAttribute('data-cta'); fromBar = false; return; }

        if (t.closest('[data-bar-add]') && addBtn && !addBtn.disabled) {
          fromBar = true;
          addBtn.click();
        }
      });

      if (msgInput && counterEl) {
        msgInput.addEventListener('input', function () {
          counterEl.textContent = msgInput.value.length + '/' + msgInput.maxLength;
        });
      }

      /* ---------- Submit ---------- */
      function showError(msg) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
        if (fromBar && errorEl.scrollIntoView) errorEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      function clearError() {
        if (!errorEl) return;
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        clearError();

        var v = current();
        if (!v || !v.available || busy) return;

        var isBuy = lastCta === 'buy';
        busy = true;
        render();

        fetch('/cart/add.js', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        })
          .then(function (res) {
            if (!res.ok) {
              return res.json().catch(function () { return {}; }).then(function (err) {
                throw new Error(err.description || err.message || 'Could not add to cart');
              });
            }
            return res.json();
          })
          .then(function () {
            document.dispatchEvent(new CustomEvent('cart:updated'));
            if (isBuy) {
              window.location.href = '/checkout';
              return;
            }
            busy = false;
            flash = 'Added ✓';
            render();
            document.dispatchEvent(new CustomEvent('cart:open'));
            window.setTimeout(function () { flash = ''; render(); }, 1600);
          })
          .catch(function (err) {
            busy = false;
            render();
            showError(err.message || 'Could not add to cart');
          });
      });

      /* ---------- Sticky bar visibility ---------- */
      var cta = document.getElementById('sh-cta');
      var ctaVisible = false;
      var sectionVisible = false;

      function updateBar() {
        if (!bar) return;
        var show = sectionVisible && !ctaVisible;
        swap(bar, [show ? BAR_SHOW : BAR_HIDE], [show ? BAR_HIDE : BAR_SHOW]);
        bar.classList.toggle('pointer-events-none', !show);
        bar.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (barBtn) barBtn.tabIndex = show ? 0 : -1;
      }

      if (bar && cta && 'IntersectionObserver' in window) {
        var ioCta = new IntersectionObserver(function (entries) {
          ctaVisible = entries[0].isIntersecting;
          updateBar();
        });
        var ioSection = new IntersectionObserver(function (entries) {
          sectionVisible = entries[0].isIntersecting;
          updateBar();
        });
        ioCta.observe(cta);
        ioSection.observe(root);
        observers.push(ioCta, ioSection);
      }

      render();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}