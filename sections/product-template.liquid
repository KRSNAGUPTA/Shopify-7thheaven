<section class="full-width py-8 md:py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" id="sh-product" data-prep-hours="{{ product.metafields.custom.prep_hours.value | default: 2 }}">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        {% if product.featured_image %}
          {{ product.featured_image
            | image_url: width: 800
            | image_tag: id: 'sh-product-image', class: 'w-full rounded-2xl', alt: product.featured_image.alt | default: product.title
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full rounded-2xl' }}
        {% endif %}
      </div>

      <div>
        <h1 class="mb-2 text-3xl">{{ product.title | escape }}</h1>

        {% if product.metafields.custom.serves %}
          <p class="text-sm text-sh-text-light">{{ 'products.serves' | t }}: {{ product.metafields.custom.serves.value }}</p>
        {% endif %}

        {% if product.metafields.custom.prep_hours %}
          <p class="text-sm text-sh-text-light">{{ 'products.ready_in' | t }}: {{ product.metafields.custom.prep_hours.value }} {{ 'products.hours' | t }}</p>
        {% endif %}

        {% if product.metafields.custom.eggless_available %}
          <span class="mt-2 inline-block rounded-full bg-[#fdecea] px-3 py-1 text-sm font-semibold text-[#a12a1f]">{{ 'products.eggless_available' | t }}</span>
        {% endif %}

        <p class="mt-4 text-3xl font-bold text-sh-accent" id="sh-product-price">
          {% if product.price_varies %}
            {% assign from_price = product.price_min | money %}
            {{ 'products.from_price' | t: price: from_price }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </p>

        {% if product.description != blank %}
          <div class="my-6 leading-relaxed text-sh-text-light">
            {{ product.description }}
          </div>
        {% endif %}

        {% form 'product', product, id: 'sh-product-form' %}
          <input type="hidden" name="properties[Fulfilment store]" id="sh-fulfilment-store" value="">
          <div class="mt-6">
            <label for="sh-variant-select" class="mb-2 block font-semibold text-sh-brown">
              {{ 'products.weight_and_type' | t }}
            </label>
            <select
              name="id"
              id="sh-variant-select"
              required
              class="w-full rounded-lg border border-sh-border px-4 py-3 text-base"
            >
              <option value="">{{ 'products.select_variant' | t }}</option>
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="mt-6">
            <label for="sh-cake-message" class="mb-2 block font-semibold text-sh-brown">
              {{ 'products.message_on_cake' | t }}
            </label>
            <textarea
              name="properties[Message on cake]"
              id="sh-cake-message"
              maxlength="30"
              placeholder="{{ 'products.message_placeholder' | t }}"
              class="min-h-20 w-full resize-y rounded-lg border border-sh-border px-4 py-3 text-base"
            ></textarea>
            <p class="mt-1 text-sm text-sh-text-light">
              <span id="sh-message-count">0</span>/30
            </p>
          </div>

          <div class="mt-6">
            <label for="sh-delivery-date" class="mb-2 block font-semibold text-sh-brown">
              {{ 'products.delivery_date' | t }} *
            </label>
            <input
              type="date"
              name="properties[Delivery date]"
              id="sh-delivery-date"
              required
              class="w-full rounded-lg border border-sh-border px-4 py-3 text-base"
            >
            <p class="mt-1 text-sm text-sh-text-light">
              {{ 'products.delivery_date_hint' | t }}
            </p>
          </div>

          <div class="mt-6">
            <p class="mb-2 font-semibold text-sh-brown">{{ 'products.delivery_slot' | t }} *</p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <label class="relative cursor-pointer">
                <input type="radio" name="properties[Delivery slot]" value="Morning (11 AM - 1 PM)" required class="peer sr-only">
                <span class="block rounded-lg border-2 border-sh-border px-3 py-3 text-center font-medium transition-colors peer-checked:border-sh-accent peer-checked:bg-sh-accent-light">
                  {{ 'products.slot_morning' | t }}<br>
                  <small>11 AM – 1 PM</small>
                </span>
              </label>
              <label class="relative cursor-pointer">
                <input type="radio" name="properties[Delivery slot]" value="Afternoon (1 PM - 5 PM)" class="peer sr-only">
                <span class="block rounded-lg border-2 border-sh-border px-3 py-3 text-center font-medium transition-colors peer-checked:border-sh-accent peer-checked:bg-sh-accent-light">
                  {{ 'products.slot_afternoon' | t }}<br>
                  <small>1 PM – 5 PM</small>
                </span>
              </label>
              <label class="relative cursor-pointer">
                <input type="radio" name="properties[Delivery slot]" value="Evening (5 PM - 9 PM)" class="peer sr-only">
                <span class="block rounded-lg border-2 border-sh-border px-3 py-3 text-center font-medium transition-colors peer-checked:border-sh-accent peer-checked:bg-sh-accent-light">
                  {{ 'products.slot_evening' | t }}<br>
                  <small>5 PM – 9 PM</small>
                </span>
              </label>
            </div>
          </div>

          <div class="mt-8 rounded-lg bg-sh-accent-light p-4" id="sh-store-info" style="display: none;">
            <p class="m-0 font-semibold text-sh-brown">
              <span id="sh-store-name"></span>
            </p>
          </div>

          <p id="sh-product-error" class="mt-4 font-semibold text-sh-accent" style="display: none;"></p>

          <button
            type="submit"
            id="sh-add-to-cart"
            class="mt-8 hidden w-full items-center justify-center rounded-xl bg-sh-accent px-6 py-4 text-lg font-semibold text-white shadow-sm transition-all hover:bg-[#b8234c] active:scale-95 sm:inline-flex"
          >
            {{ 'products.add_to_cart' | t }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<div class="fixed inset-x-0 bottom-0 z-[90] border-t border-sh-border bg-white p-3 shadow-[0_-4px_12px_rgba(0,0,0,0.08)] sm:hidden" id="sh-sticky-atc">
  <button type="submit" form="sh-product-form" id="sh-sticky-atc-btn" class="flex w-full items-center justify-center rounded-xl bg-sh-accent px-6 py-3 font-semibold text-white shadow-sm transition-all hover:bg-[#b8234c] active:scale-95">
    {{ 'products.add_to_cart' | t }}
  </button>
</div>


{% javascript %}
  (function () {
    var form = document.getElementById('sh-product-form');
    if (!form) return;

    var messageInput = document.getElementById('sh-cake-message');
    var messageCount = document.getElementById('sh-message-count');
    var deliveryDateInput = document.getElementById('sh-delivery-date');
    var variantSelect = document.getElementById('sh-variant-select');
    var storeInfo = document.getElementById('sh-store-info');
    var storeName = document.getElementById('sh-store-name');
    var storeField = document.getElementById('sh-fulfilment-store');
    var errorEl = document.getElementById('sh-product-error');
    var priceEl = document.getElementById('sh-product-price');
    var root = document.getElementById('sh-product');
    var prepHours = Number(root && root.dataset.prepHours) || 2;

    var storeLabels = {
      andheri: '7th Heaven Andheri',
      thane: '7th Heaven Thane'
    };

    messageInput.addEventListener('input', function () {
      messageCount.textContent = String(messageInput.value.length);
    });

    function setMinDeliveryDate() {
      var minDate = new Date();
      minDate.setDate(minDate.getDate() + 1);
      if (prepHours >= 6) minDate.setDate(minDate.getDate() + 1);
      var y = minDate.getFullYear();
      var m = String(minDate.getMonth() + 1).padStart(2, '0');
      var d = String(minDate.getDate()).padStart(2, '0');
      var minDateStr = y + '-' + m + '-' + d;
      deliveryDateInput.min = minDateStr;
      deliveryDateInput.value = minDateStr;
    }

    function updateStoreDisplay() {
      var savedStore = localStorage.getItem('sh-store');
      var savedPincode = localStorage.getItem('sh-pincode');
      if (savedStore && savedPincode) {
        storeField.value = storeLabels[savedStore] || savedStore;
        storeName.textContent = 'Delivering from ' + (storeLabels[savedStore] || savedStore) + ' (' + savedPincode + ')';
        storeInfo.style.display = 'block';
      } else {
        storeField.value = '';
        storeInfo.style.display = 'none';
      }
    }

    setMinDeliveryDate();
    updateStoreDisplay();
    window.addEventListener('sh:pincode-updated', updateStoreDisplay);

    variantSelect.addEventListener('change', function () {
      var option = variantSelect.options[variantSelect.selectedIndex];
      if (option && option.value && option.dataset.price) {
        priceEl.textContent = option.dataset.price;
      }
    });

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.style.display = 'none';

      var savedStore = localStorage.getItem('sh-store');
      if (!savedStore) {
        showError('Please enter your pincode in the header before adding to cart.');
        document.getElementById('sh-pincode-btn')?.click();
        return;
      }

      if (!variantSelect.value) {
        showError('Please select weight and type.');
        return;
      }

      if (!form.querySelector('input[name="properties[Delivery slot]"]:checked')) {
        showError('Please choose a delivery slot.');
        return;
      }

      storeField.value = storeLabels[savedStore] || savedStore;

      var submitBtns = [document.getElementById('sh-add-to-cart'), document.getElementById('sh-sticky-atc-btn')];
      submitBtns.forEach(function (btn) {
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Adding…';
        }
      });

      try {
        var formData = new FormData(form);
        var res = await fetch(window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' }
        });

        if (!res.ok) {
          var err = await res.json().catch(function () { return {}; });
          throw new Error(err.description || err.message || 'Could not add to cart');
        }

        document.dispatchEvent(new CustomEvent('sh:cart:updated'));
        document.dispatchEvent(new CustomEvent('sh:cart:open'));
      } catch (err) {
        showError(err.message || 'Could not add to cart');
      } finally {
        submitBtns.forEach(function (btn) {
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Add to cart';
          }
        });
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product template",
  "settings": []
}
{% endschema %}
