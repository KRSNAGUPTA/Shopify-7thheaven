{%- comment -%}
Premium Featured Collection Section
Enhanced UI/UX with improved visual hierarchy, interactions, and premium feel
{%- endcomment -%}

<div class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto font-sans-custom">
  {%- comment -%}Section Header{%- endcomment -%}
  <div class="text-center mb-20 space-y-4 max-w-2xl mx-auto">
    <h1 class="font-sniglet text-4xl sm:text-5xl font-bold text-[#2C1810] tracking-tight leading-tight">
      {{ section.settings.title | default: 'Our Premium Selection' }}
    </h1>
    {%- if section.settings.description != blank -%}
      <p class="text-base sm:text-lg text-gray-600 font-light leading-relaxed">
        {{ section.settings.description }}
      </p>
    {%- endif -%}
  </div>

  {%- assign collection = collections[section.settings.collection] -%}
  {%- assign products_limit = section.settings.products_to_show | default: 8 -%}
  
<div class="flex flex-wrap justify-center gap-4 sm:gap-7 lg:gap-7 max-w-6xl mx-auto">
  {%- if collection != blank and collection.products.size > 0 -%}
    {%- for product in collection.products limit: products_limit -%}
      <div class="group flex flex-col bg-white rounded-2xl border border-amber-50 overflow-hidden transition-all duration-300 w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-1.25rem)]">
          <div class="relative aspect-square w-full  overflow-hidden flex items-center justify-center">
            {%- if section.settings.show_badges -%}
              {%- if product.available == false -%}
                <span class="absolute top-3 left-3 bg-black/70 backdrop-blur-md text-white text-[0.65rem] uppercase font-bold tracking-widest py-1.5 px-3 rounded-full z-10">
                  Sold Out
                </span>
              {%- endif -%}
            {%- endif -%}

            {%- comment -%}Product Image{%- endcomment -%}
            <a href="{{ product.url }}" class="block w-full h-full">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: class: 'w-full h-full object-contain ', loading: 'lazy', alt: product.title }}
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">No Image</div>
              {%- endif -%}
            </a>
          </div>

          {%- comment -%}Product Content{%- endcomment -%}
          <div class="flex flex-col flex-1 p-4 space-y-2">
            
            {%- comment -%}Pricing{%- endcomment -%}
            <div class="flex flex-row justify-between items-center gap-4">
              <div class="font-sniglet text-3xl font-medium text-[#E91E63] tracking-tight">
                {{ product.price | money }}
              </div>
              {%- if product.compare_at_price > product.price -%}
                <p class="text-xl text-gray-500 line-through">
                  {{ product.compare_at_price | money }}
                </p>
              {%- endif -%}
            </div>

            {%- comment -%}Product Title{%- endcomment -%}
            <h3 class="text-xl line-clamp-2">
              <a href="{{ product.url }}" class="hover:no-underline font-medium font-sniglet">{{ product.title }}</a>
            </h3>

            {%- comment -%}Product Description{%- endcomment -%}
            <p class="text-sm text-gray-600 line-clamp-2 leading-relaxed font-light flex-1">
              {{ product.description | strip_html | default: 'Handcrafted fresh, baked daily with premium ingredients.' }}
            </p>

            {%- comment -%}Action Buttons{%- endcomment -%}
            <div class="flex items-center gap-2 pt-4 mt-auto">
              {%- form 'product', product, id: product.id, class: 'flex-1 ajax-add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  name="add"
                  class="cursor-pointer w-full py-3 px-4 rounded-full flex items-center justify-center gap-2 text-white text-sm font-semibold bg-sh-accent-dark hover:bg-sh-accent-dark transition-all duration-200  active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                  {%- unless product.available -%}disabled{%- endunless -%}
                  title="Add to Cart"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span class="btn-text">Add to Cart</span>
                </button>
              {%- endform -%}

            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}Loading Skeleton{%- endcomment -%}
      {%- for i in (1..products_limit) -%}
        <div class="space-y-4">
          <div class="aspect-square bg-gradient-to-r from-amber-50 via-amber-100 to-amber-50 rounded-2xl animate-pulse"></div>
          <div class="h-6 bg-gradient-to-r from-gray-100 via-gray-200 to-gray-100 rounded-lg animate-pulse w-2/3"></div>
          <div class="h-4 bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 rounded-lg animate-pulse w-1/2"></div>
          <div class="h-10 bg-gradient-to-r from-pink-100 via-pink-200 to-pink-100 rounded-lg animate-pulse"></div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.ajax-add-to-cart-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const button = form.querySelector('button[type="submit"]');
        const btnText = form.querySelector('.btn-text');
        const originalText = btnText ? btnText.textContent : 'Add to Cart';

        // Provide immediate visual feedback
        if (button) button.disabled = true;
        if (btnText) btnText.textContent = 'Adding...';

        try {
          const formData = new FormData(form);
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          if (!response.ok) throw new Error('Failed to add to cart');

          const item = await response.json();

          // Temporarily show success state on button
          if (btnText) btnText.textContent = 'Added!';
          
          // Trigger custom event for theme drawers or cart bubble updates
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item } }));

        } catch (error) {
          console.error('Error adding item to cart:', error);
          if (btnText) btnText.textContent = 'Error!';
        } finally {
          setTimeout(() => {
            if (button) button.disabled = false;
            if (btnText) btnText.textContent = originalText;
          }, 1500);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Premium Selection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted treats delivered fresh to your door. Each item is made with love and the finest ingredients."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges (New/Sold Out)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show rating and stock indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Premium Featured Collection"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .font-sniglet {
    font-family: 'Sniglet', cursive, sans-serif;
  }
  
  .font-sans-custom {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-4px); }
  }
  
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
{% endstylesheet %}