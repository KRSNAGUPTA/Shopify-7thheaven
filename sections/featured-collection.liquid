{%- comment -%}
  Featured Collection — modern minimal grid
  - Transparent product images (no card backgrounds)
  - Centered last row when items are odd
  - Uses shared snippets/product-card.liquid
{%- endcomment -%}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign products_limit = section.settings.products_to_show | default: 6 -%}

{%- assign card_width = 'w-[calc((100%-0.75rem)/2)] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4rem)/3)]' -%}

<section
  id="FeaturedCollection-{{ section.id }}"
  class="py-12 sm:py-16 lg:py-24 px-5 sm:px-6 lg:px-8 max-w-7xl mx-auto font-body"
>
  {%- comment -%}Section Header{%- endcomment -%}
  {%- if section.settings.title != blank or section.settings.description != blank -%}
    <div class="text-center mb-10 sm:mb-12 lg:mb-16 max-w-3xl mx-auto">
      {%- if section.settings.title != blank -%}
        <h2 class="font-sniglet text-[1.75rem] sm:text-4xl lg:text-5xl font-medium text-sh-brown tracking-[-0.02em] leading-[1.1] [text-wrap:balance]">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="mt-3 sm:mt-4 lg:mt-5 mx-auto max-w-xl text-[0.95rem] sm:text-base lg:text-[1.125rem] text-sh-text-light leading-[1.65] [text-wrap:pretty]">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="flex flex-wrap justify-center gap-3 sm:gap-6 lg:gap-8 max-w-6xl mx-auto">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: products_limit -%}
        {%- assign eager = false -%}
        {%- if forloop.index <= 3 -%}
          {%- assign eager = true -%}
        {%- endif -%}
        {%- assign lazy_flag = true -%}
        {%- if eager -%}
          {%- assign lazy_flag = false -%}
        {%- endif -%}
        {% render 'product-card', product: product, show_badges: section.settings.show_badges, class: card_width, lazy: lazy_flag %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..products_limit) -%}
        <div class="{{ card_width }}" aria-hidden="true">
          <div class="aspect-square rounded-2xl border border-dashed border-sh-border"></div>
          <div class="mt-3 space-y-2 sm:mt-4">
            <div class="h-4 w-3/4 rounded bg-sh-border/60"></div>
            <div class="h-5 w-1/3 rounded bg-sh-border/60"></div>
            <div class="mt-3 flex gap-2">
              <div class="h-9 flex-1 rounded-full bg-sh-border/60"></div>
              <div class="h-9 w-11 rounded-full bg-sh-border/60 sm:w-12"></div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Premium Selection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted treats delivered fresh to your door."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges (Sale / Sold Out)",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}