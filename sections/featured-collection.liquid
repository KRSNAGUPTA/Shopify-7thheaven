{%- comment -%}
  Premium Featured Collection Section
{%- endcomment -%}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign products_limit = section.settings.products_to_show | default: 6 -%}

{%- comment -%}
  Card widths: 2 per row on mobile, 3 on desktop. Each calc subtracts the gaps,
  so rows always fit exactly and leftover cards center on the last row.
{%- endcomment -%}
{%- assign card_width = 'w-[calc((100%-0.75rem)/2)] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4rem)/3)]' -%}

<section
  id="FeaturedCollection-{{ section.id }}"
  class="py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto font-body"
>
  {%- comment -%}Section Header{%- endcomment -%}
  <div class="text-center mb-10 sm:mb-14 lg:mb-16 space-y-3 sm:space-y-4 max-w-2xl mx-auto">
    <h2 class="font-sniglet text-3xl sm:text-4xl lg:text-5xl font-bold text-sh-brown tracking-tight leading-tight">
      {{ section.settings.title | default: 'Our Premium Selection' }}
    </h2>
    {%- if section.settings.description != blank -%}
      <p class="text-base sm:text-lg text-sh-text-light leading-relaxed">
        {{ section.settings.description }}
      </p>
    {%- endif -%}
  </div>

  <div class="flex flex-wrap justify-center gap-3 sm:gap-6 lg:gap-8 max-w-6xl mx-auto">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: products_limit -%}
        <article class="flex flex-col {{ card_width }}">

          {%- comment -%}Image{%- endcomment -%}
          <div class="relative aspect-square w-full">
            {%- if section.settings.show_badges -%}
              {%- if product.available == false -%}
                <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-sh-brown-dark text-white text-[0.6rem] sm:text-[0.65rem] uppercase font-bold tracking-widest py-1 px-2.5 sm:py-1.5 sm:px-3 rounded-full z-10">
                  Sold Out
                </span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-sh-primary-dark text-white text-[0.6rem] sm:text-[0.65rem] uppercase font-bold tracking-widest py-1 px-2.5 sm:py-1.5 sm:px-3 rounded-full z-10">
                  Sale
                </span>
              {%- endif -%}
            {%- endif -%}

            <a href="{{ product.url }}" class="block w-full h-full" aria-label="{{ product.title | escape }}">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 700
                  | image_tag:
                    widths: '300, 500, 700',
                    sizes: '(min-width: 1280px) 380px, (min-width: 1024px) 30vw, 50vw',
                    class: 'w-full h-full object-contain',
                    loading: 'lazy',
                    alt: product.featured_media.alt | default: product.title
                }}
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center text-sh-text-light text-sm">No Image</div>
              {%- endif -%}
            </a>
          </div>

          {%- comment -%}Content{%- endcomment -%}
          <div class="flex flex-col flex-1 p-3 sm:p-5 gap-2">

            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
              <span class="font-sniglet text-xl sm:text-2xl lg:text-3xl text-sh-primary-dark tracking-tight">
                {{ product.price | money }}
              </span>
              {%- if product.compare_at_price > product.price -%}
                <s class="text-sm sm:text-base text-sh-text-light">
                  {{ product.compare_at_price | money }}
                </s>
              {%- endif -%}
            </div>

            <h3 class="text-base sm:text-lg lg:text-xl leading-snug line-clamp-2">
              <a href="{{ product.url }}" class="font-sniglet font-medium text-sh-brown hover:text-sh-brown">
                {{ product.title }}
              </a>
            </h3>

            <p class="hidden sm:block text-sm text-sh-text-light line-clamp-2 leading-relaxed flex-1">
              {{- product.description | strip_html | default: 'Handcrafted fresh, baked daily with premium ingredients.' -}}
            </p>

            {%- comment -%}Add to cart{%- endcomment -%}
            <div class="pt-2 sm:pt-4 mt-auto">
              {%- form 'product', product, id: product.id, class: 'ajax-add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  name="add"
                  data-state="idle"
                  class="cursor-pointer w-full py-2.5 sm:py-3 px-3 sm:px-4 rounded-full flex items-center justify-center gap-2 text-white text-sm font-semibold bg-sh-primary hover:bg-sh-primary-dark data-[state=added]:bg-sh-success data-[state=added]:hover:bg-sh-success data-[state=error]:bg-sh-error data-[state=error]:hover:bg-sh-error transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 disabled:bg-sh-text-light disabled:opacity-60 disabled:cursor-not-allowed data-[state=loading]:disabled:bg-sh-primary data-[state=loading]:disabled:opacity-80 data-[state=added]:disabled:bg-sh-success data-[state=added]:disabled:opacity-100"
                  {% unless product.available %}disabled{% endunless %}
                >
                  <span class="relative w-4 h-4 shrink-0" aria-hidden="true">
                    <svg class="icon-cart absolute inset-0 w-4 h-4 transition-opacity duration-300 motion-reduce:transition-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <svg class="icon-check absolute inset-0 w-4 h-4 opacity-0 transition-opacity duration-300 motion-reduce:transition-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                  </span>
                  <span class="btn-text transition-opacity duration-150 motion-reduce:transition-none" aria-live="polite">
                    {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
                  </span>
                </button>
              {%- endform -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}Placeholder (shows only when no collection is selected){%- endcomment -%}
      {%- for i in (1..products_limit) -%}
        <div class="{{ card_width }}" aria-hidden="true">
          <div class="aspect-square border border-sh-border rounded-2xl"></div>
          <div class="p-3 sm:p-5 space-y-3">
            <div class="h-6 bg-sh-border rounded-lg w-1/3"></div>
            <div class="h-5 bg-sh-border rounded-lg w-3/4"></div>
            <div class="h-10 bg-sh-border rounded-full mt-4"></div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('FeaturedCollection-{{ section.id }}');
    if (!root) return;

    const LABELS = {
      idle: 'Add to Cart',
      loading: 'Adding...',
      added: 'Added to cart',
      error: "Couldn't add. Try again"
    };

    // Add data-cart-count to your header's cart number element (recommended).
    // The other selectors are fallbacks for common theme class names.
    const COUNT_SELECTORS = [
      '[data-cart-count]',
      '.cart-count',
      '.cart-count-bubble span',
      '.cart-count-bubble',
      '#cart-count',
      '#CartCount'
    ].join(',');

    const haptic = (pattern) => {
      try {
        if ('vibrate' in navigator) navigator.vibrate(pattern);
      } catch (_) {}
    };

    const updateCartCount = (count) => {
      document.querySelectorAll(COUNT_SELECTORS).forEach((el) => {
        el.textContent = count;
        el.hidden = count === 0;
        el.classList.toggle('hidden', count === 0);
        el.setAttribute('data-cart-count', count);
      });
    };

    const setState = (button, state) => {
      const text = button.querySelector('.btn-text');
      const cartIcon = button.querySelector('.icon-cart');
      const checkIcon = button.querySelector('.icon-check');
      button.dataset.state = state;

      if (text) {
        text.style.opacity = '0';
        setTimeout(() => {
          text.textContent = LABELS[state];
          text.style.opacity = '1';
        }, 120);
      }
      if (cartIcon) cartIcon.style.opacity = state === 'added' ? '0' : '1';
      if (checkIcon) checkIcon.style.opacity = state === 'added' ? '1' : '0';
    };

    root.addEventListener('submit', async (e) => {
      const form = e.target.closest('.ajax-add-to-cart-form');
      if (!form) return;

      e.preventDefault();

      const button = form.querySelector('button[type="submit"]');
      if (!button || button.disabled) return;

      clearTimeout(button._resetTimer);
      button.disabled = true;
      setState(button, 'loading');

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/json' }
        });
        if (!response.ok) throw new Error('Failed to add to cart');

        const item = await response.json();

        // Get the real cart total so the header count is always correct
        const cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } })
          .then((r) => r.json());

        updateCartCount(cart.item_count);
        setState(button, 'added');
        haptic(30);

        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item, cart } }));
      } catch (error) {
        console.error('Error adding item to cart:', error);
        setState(button, 'error');
        haptic([40, 60, 40]);
      } finally {
        button._resetTimer = setTimeout(() => {
          setState(button, 'idle');
          button.disabled = false;
        }, 2000);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Premium Selection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted treats delivered fresh to your door. Each item is made with love and the finest ingredients."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges (Sale / Sold Out)",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Premium Featured Collection"
    }
  ]
}
{% endschema %}