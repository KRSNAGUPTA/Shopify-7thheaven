{%- assign announcement = section.settings.announcement_text -%}
{%- if announcement == blank -%}
  {%- assign announcement = 'general.announcement' | t -%}
{%- endif -%}

<div class="sticky top-0 z-40">
  {%- if section.settings.show_announcement -%}
    <div
      id="sh-announce"
      data-hidden="false"
      class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-[400ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] will-change-[grid-template-rows] [transform:translateZ(0)] data-[hidden=true]:grid-rows-[0fr] motion-reduce:transition-none"
    >
      <div class="min-h-0 overflow-hidden">
        <div class="border-b border-sh-border bg-sh-cream-light text-sh-brown">
          <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-4 py-2 text-center text-xs font-medium tracking-wide sm:text-[13px]">
            {%- if section.settings.announcement_link != blank -%}
              <a
                href="{{ section.settings.announcement_link }}"
                class="cursor-pointer text-sh-brown underline-offset-4 hover:text-sh-primary-dark hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
              >
                {{ announcement }}
              </a>
            {%- else -%}
              <span>{{ announcement }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <header class="w-full border-b border-white/10 bg-sh-brown-dark/95 backdrop-blur-xl backdrop-saturate-150 supports-[backdrop-filter]:bg-sh-brown-dark/70">
    <div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-2 sm:px-6 md:flex md:py-2.5 lg:px-8">
      {%- comment -%}Mobile menu button{%- endcomment -%}
      <div class="md:hidden">
        <button
          type="button"
          data-menu-open
          class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 active:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
          aria-label="{{ 'general.open_menu' | t }}"
          aria-controls="sh-mobile-menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h10"></path>
          </svg>
        </button>
      </div>

      {%- comment -%}Logo{%- endcomment -%}
      <a
        href="{{ routes.root_url }}"
        class="flex shrink-0 cursor-pointer items-center justify-self-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
      >
        {%- if section.settings.logo != blank -%}
          {%- assign logo_width = section.settings.logo_width -%}
          {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
          {{
            section.settings.logo
            | image_url: width: logo_width
            | image_tag:
              width: logo_width,
              height: logo_height,
              loading: 'eager',
              class: 'h-12 w-auto object-contain sm:h-14 md:h-16',
              alt: section.settings.logo.alt | default: shop.name | escape
          }}
        {%- else -%}
          <span class="text-xl font-extrabold tracking-tight text-white sm:text-2xl">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- comment -%}Desktop nav (pill){%- endcomment -%}
      <nav class="hidden md:flex md:flex-1 md:justify-center" aria-label="{{ 'general.primary_nav' | t }}">
        {%- if section.settings.menu != blank -%}
          <div class="flex items-center gap-1 rounded-full border border-white/10 bg-white/5 p-1">
            {%- for link in section.settings.menu.links -%}
              <a
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
                class="cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors hover:bg-white/10 hover:text-white active:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary lg:px-4 lg:py-2 lg:text-sm {% if link.current %}bg-white/10 text-white{% else %}text-sh-cream/90{% endif %}"
              >
                {{ link.title }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </nav>

      {%- comment -%}Actions{%- endcomment -%}
      <div class="flex items-center justify-end gap-1.5 sm:gap-2">
        <button
          type="button"
          data-pincode-open
          class="inline-flex h-10 cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3 text-xs font-semibold text-sh-cream transition-colors duration-200 hover:bg-white/10 active:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary sm:text-sm lg:gap-2"
          aria-label="{{ 'general.enter_pincode' | t }}"
        >
          <svg class="h-4 w-4 shrink-0 " fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span
            id="sh-pincode-label"
            data-default="{{ 'general.enter_pincode' | t | escape }}"
            class="hidden max-w-[7rem] truncate sm:inline lg:max-w-[8rem]"
          >
            {{- 'general.enter_pincode' | t -}}
          </span>
          <span
            id="sh-pincode-dot"
            class="hidden h-1.5 w-1.5 rounded-full bg-sh-success sm:hidden"
            aria-hidden="true"
          ></span>
        </button>

        <button
          type="button"
          data-cart-open
          class="relative inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 active:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
          aria-label="{{ 'cart.title' | t }}"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span
            data-cart-count
            {% if cart.item_count == 0 %}hidden{% endif %}
            class="absolute -right-0.5 -top-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full border-2 border-sh-brown-dark bg-sh-primary px-1 text-[10px] font-bold text-white"
          >
            {{- cart.item_count -}}
          </span>
        </button>
      </div>
    </div>
  </header>
</div>

{%- comment -%}
  Mobile menu.
  Open/closed state is driven by [data-open] on #sh-mobile-menu and styled in the
  {% stylesheet %} block below (no reliance on child data-variants).
  This element is moved to <body> on init so fixed positioning is never trapped
  by a transformed/filtered ancestor.
{%- endcomment -%}
<div
  id="sh-mobile-menu"
  data-open="false"
  aria-hidden="true"
  class="sh-mobile-menu fixed inset-0 z-[900] touch-manipulation [-webkit-tap-highlight-color:transparent] md:hidden"
>
  {%- comment -%}Overlay{%- endcomment -%}
  <div
    data-menu-close
    class="sh-menu-overlay absolute inset-0 cursor-pointer bg-sh-brown-dark/60 backdrop-blur-sm"
    aria-hidden="true"
  ></div>

  {%- comment -%}Panel{%- endcomment -%}
  <nav
    class="sh-menu-panel absolute inset-y-0 left-0 flex w-80 max-w-[85%] flex-col border-r border-white/10 bg-sh-brown-dark/95 backdrop-blur-xl"
    aria-label="{{ 'general.primary_nav' | t }}"
  >
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <span class="text-lg font-bold text-white">{{ 'general.menu' | t }}</span>
      <button
        type="button"
        data-menu-close
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 active:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.close_menu' | t }}"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-3 [-webkit-overflow-scrolling:touch]">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
            class="block cursor-pointer rounded-xl px-4 py-3 text-base font-semibold transition-colors hover:bg-white/10 hover:text-white active:bg-white/15 {% if link.current %}bg-white/10 text-white{% else %}text-sh-cream{% endif %}"
          >
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="border-t border-white/10 p-4">
      <button
        type="button"
        data-pincode-open
        class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-sh-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-sh-primary-dark active:bg-sh-primary-dark/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 focus-visible:ring-offset-sh-brown-dark"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {{ 'general.check_delivery' | t }}
      </button>
    </div>
  </nav>
</div>

{%- comment -%}Pincode modal{%- endcomment -%}
<div
  id="sh-pincode-modal"
  class="fixed inset-0 z-[1000] hidden items-end justify-center bg-sh-brown-dark/50 backdrop-blur-sm touch-manipulation [-webkit-tap-highlight-color:transparent] sm:items-center sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sh-pincode-title"
  data-token="{{ section.settings.storefront_token }}"
  data-variant="{{ section.settings.probe_variant_id }}"
  data-api-version="{{ section.settings.api_version | default: '2026-01' }}"
>
  <div class="w-full max-w-md rounded-t-3xl border border-sh-border bg-sh-cream p-6 shadow-2xl sm:rounded-2xl">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sh-primary-light text-sh-primary-dark"
          aria-hidden="true"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </span>
        <div>
          <h3 id="sh-pincode-title" class="text-lg font-bold text-sh-brown">{{ 'general.pincode_title' | t }}</h3>
          <p class="text-xs text-sh-text-light">{{ 'general.pincode_hint' | t }}</p>
        </div>
      </div>
      <button
        type="button"
        data-pincode-close
        class="cursor-pointer rounded-full p-1.5 text-sh-text-light transition-colors hover:bg-sh-cream-light active:bg-sh-cream-light/80 hover:text-sh-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.close' | t }}"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <input
      type="text"
      id="sh-pincode-input"
      inputmode="numeric"
      maxlength="6"
      autocomplete="postal-code"
      placeholder="{{ 'general.pincode_placeholder' | t }}"
      class="w-full cursor-text rounded-xl border border-sh-border bg-white px-4 py-3 text-base text-sh-brown transition-colors placeholder:text-sh-text-light/60 focus:border-sh-primary focus:outline-none focus:ring-2 focus:ring-sh-primary/40"
    >

    <div id="sh-pincode-result" class="mt-3 min-h-[20px] text-sm" aria-live="polite"></div>

    <div class="mt-4 flex gap-3">
      <button
        type="button"
        data-pincode-check
        class="flex-1 cursor-pointer rounded-full bg-sh-primary px-4 py-3 font-semibold text-white transition-colors hover:bg-sh-primary-dark active:bg-sh-primary-dark/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70"
      >
        {{ 'general.check' | t }}
      </button>
      <button
        type="button"
        data-pincode-close
        class="flex-1 cursor-pointer rounded-full bg-sh-cream-light px-4 py-3 font-semibold text-sh-brown transition-colors hover:bg-sh-border active:bg-sh-border/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2"
      >
        {{ 'general.close' | t }}
      </button>
    </div>
  </div>
</div>

{%- comment -%}Translated strings as JSON{%- endcomment -%}
<script type="application/json" id="sh-pincode-strings">
  {
    "invalid": {{ 'general.pincode_invalid' | t | json }},
    "delivering": {{ 'general.pincode_delivering' | t | json }},
    "unavailable": {{ 'general.pincode_unavailable' | t | json }},
    "error": {{ "Couldn't check right now. Please try again." | json }}
  }
</script>

{% stylesheet %}
  /* Mobile menu state – driven by [data-open] on the container */
  .sh-mobile-menu {
    pointer-events: none;
  }
  .sh-mobile-menu[data-open='true'] {
    pointer-events: auto;
  }

  .sh-mobile-menu .sh-menu-overlay {
    opacity: 0;
    visibility: hidden;
    transition: opacity 350ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 350ms;
  }
  .sh-mobile-menu[data-open='true'] .sh-menu-overlay {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .sh-mobile-menu .sh-menu-panel {
    transform: translateX(-100%);
    visibility: hidden;
    will-change: transform;
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
      visibility 0s linear 400ms;
  }
  .sh-mobile-menu[data-open='true'] .sh-menu-panel {
    transform: translateX(0);
    visibility: visible;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sh-mobile-menu .sh-menu-overlay,
    .sh-mobile-menu .sh-menu-panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    var KEY_PIN = 'sh-pincode';
    var KEY_STORE = 'sh-store';
    var lastTrigger = null;
    var checking = false;

    function $(id) {
      return document.getElementById(id);
    }

    function read(key) {
      try {
        return localStorage.getItem(key);
      } catch (e) {
        return null;
      }
    }
    function write(key, value) {
      try {
        localStorage.setItem(key, value);
      } catch (e) {}
    }
    function remove(key) {
      try {
        localStorage.removeItem(key);
      } catch (e) {}
    }

    var MSG = (function () {
      var defaults = {
        invalid: 'Please enter a valid 6-digit pincode.',
        delivering: 'We deliver to',
        unavailable: "We don't deliver to this pincode yet.",
        error: "Couldn't check right now. Please try again.",
      };
      try {
        var el = document.getElementById('sh-pincode-strings');
        if (el) {
          var parsed = JSON.parse(el.textContent);
          return Object.assign(defaults, parsed);
        }
      } catch (e) {}
      return defaults;
    })();

    /* Move fixed overlays to <body> so no transformed/filtered ancestor can trap them */
    function portal(ids) {
      // Remove stale copies from a previous render (theme editor section reloads)
      ids.forEach(function (id) {
        document.querySelectorAll('body > #' + id).forEach(function (old) {
          old.parentNode.removeChild(old);
        });
      });
      ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el && el.parentNode !== document.body) document.body.appendChild(el);
      });
    }

    function lookup(pin) {
      var modal = $('sh-pincode-modal');
      var token = modal && modal.getAttribute('data-token');
      var variant = modal && modal.getAttribute('data-variant');
      var version = (modal && modal.getAttribute('data-api-version')) || '2026-01';
      if (!token || !variant) return Promise.reject(new Error('Not configured'));

      var query =
        'mutation($input: CartInput!) {' +
        '  cartCreate(input: $input) {' +
        '    cart { deliveryGroups(first: 5) { nodes { deliveryOptions { deliveryMethodType } } } }' +
        '    userErrors { message }' +
        '  }' +
        '}';

      var variables = {
        input: {
          lines: [{ merchandiseId: 'gid://shopify/ProductVariant/' + variant, quantity: 1 }],
          buyerIdentity: {
            countryCode: 'IN',
            deliveryAddressPreferences: [
              {
                deliveryAddress: { zip: pin, country: 'IN', province: 'MH' },
              },
            ],
          },
        },
      };

      var ctrl = new AbortController();
      var timer = setTimeout(function () {
        ctrl.abort();
      }, 8000);

      return fetch('/api/' + version + '/graphql.json', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': token,
        },
        body: JSON.stringify({ query: query, variables: variables }),
        signal: ctrl.signal,
      })
        .then(function (r) {
          if (!r.ok) throw new Error('Bad response');
          return r.json();
        })
        .then(function (json) {
          var cart = json && json.data && json.data.cartCreate && json.data.cartCreate.cart;
          if (!cart) throw new Error('No cart');

          var groups = (cart.deliveryGroups && cart.deliveryGroups.nodes) || [];
          var local = groups.some(function (g) {
            return (g.deliveryOptions || []).some(function (o) {
              return o.deliveryMethodType === 'LOCAL';
            });
          });

          return { serviceable: local };
        })
        .finally(function () {
          clearTimeout(timer);
        });
    }

    function setCartCount(count) {
      count = Number(count) || 0;
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = count > 99 ? '99+' : count;
        el.hidden = count <= 0;
      });
    }

    function refreshCartCount() {
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) {
          return r.json();
        })
        .then(function (cart) {
          setCartCount(cart.item_count);
        })
        .catch(function () {});
    }

    document.addEventListener('cart:updated', function (event) {
      var cart = event && event.detail && event.detail.cart;
      if (cart && typeof cart.item_count !== 'undefined') setCartCount(cart.item_count);
      else refreshCartCount();
    });

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) refreshCartCount();
    });

    function syncLock() {
      var menu = $('sh-mobile-menu');
      var modal = $('sh-pincode-modal');
      var locked =
        (menu && menu.getAttribute('data-open') === 'true') ||
        (modal && !modal.classList.contains('hidden'));
      document.body.classList.toggle('overflow-hidden', !!locked);
    }

    function setMenu(open) {
      var menu = $('sh-mobile-menu');
      if (!menu) return;
      menu.setAttribute('data-open', open ? 'true' : 'false');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      var btn = document.querySelector('[data-menu-open]');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      syncLock();
    }

    function showResult(kind, text) {
      var box = $('sh-pincode-result');
      if (!box) return;
      box.textContent = '';
      if (!text) return;

      var p = document.createElement('p');
      p.className = 'font-semibold ' + (kind === 'ok' ? 'text-sh-success' : 'text-sh-error');
      p.textContent = text;
      box.appendChild(p);
    }

    function openModal() {
      var modal = $('sh-pincode-modal');
      var input = $('sh-pincode-input');
      if (!modal) return;
      setMenu(false);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      showResult('', '');
      if (input) {
        input.value = read(KEY_PIN) || '';
        window.setTimeout(function () {
          input.focus();
          input.select();
        }, 100);
      }
      syncLock();
    }

    function closeModal() {
      var modal = $('sh-pincode-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      syncLock();
      if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
    }

    function renderSaved() {
      var label = $('sh-pincode-label');
      var dot = $('sh-pincode-dot');
      if (!label) return;

      var pin = read(KEY_PIN);
      var ok = read(KEY_STORE);

      if (pin && ok) {
        label.textContent = pin;
        label.title = pin;
        if (dot) {
          dot.classList.remove('hidden');
          dot.classList.add('inline-block');
        }
      } else {
        label.textContent = label.getAttribute('data-default') || '';
        label.removeAttribute('title');
        if (dot) {
          dot.classList.add('hidden');
          dot.classList.remove('inline-block');
        }
      }
    }

    function checkPincode() {
      var modal = $('sh-pincode-modal');
      var input = $('sh-pincode-input');
      var btn = modal && modal.querySelector('[data-pincode-check]');
      if (!modal || !input || checking) return;

      var pin = (input.value || '').trim();
      if (!/^\d{6}$/.test(pin)) {
        showResult('error', MSG.invalid);
        return;
      }

      checking = true;
      var original = btn ? btn.textContent : '';
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Checking...';
      }

      lookup(pin)
        .then(function (data) {
          if (data && data.serviceable) {
            write(KEY_PIN, pin);
            write(KEY_STORE, 'local');
            showResult('ok', MSG.delivering + ' ' + pin);
            renderSaved();
            window.dispatchEvent(
              new CustomEvent('sh:pincode-updated', {
                detail: { pincode: pin, serviceable: true },
              })
            );
          } else {
            remove(KEY_PIN);
            remove(KEY_STORE);
            renderSaved();
            showResult('error', MSG.unavailable);
          }
        })
        .catch(function () {
          showResult('error', MSG.error);
        })
        .finally(function () {
          checking = false;
          if (btn) {
            btn.disabled = false;
            btn.textContent = original;
          }
        });
    }

    /* Bind global listeners only once (init can re-run on section reload) */
    if (!window.__shHeaderBound) {
      window.__shHeaderBound = true;

      document.addEventListener('click', function (event) {
        var t = event.target;
        if (!t || !t.closest) return;

        if (t.closest('[data-menu-open]')) {
          event.preventDefault();
          setMenu(true);
          return;
        }
        if (t.closest('[data-menu-close]')) {
          event.preventDefault();
          setMenu(false);
          return;
        }

        var opener = t.closest('[data-pincode-open]');
        if (opener) {
          event.preventDefault();
          lastTrigger = opener;
          openModal();
          return;
        }
        if (t.closest('[data-pincode-close]')) {
          event.preventDefault();
          closeModal();
          return;
        }
        if (t.closest('[data-pincode-check]')) {
          event.preventDefault();
          checkPincode();
          return;
        }

        var modal = $('sh-pincode-modal');
        if (modal && t === modal) closeModal();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          var modal = $('sh-pincode-modal');
          if (modal && !modal.classList.contains('hidden')) closeModal();
          setMenu(false);
        }
        if (event.key === 'Enter' && event.target && event.target.id === 'sh-pincode-input') {
          event.preventDefault();
          checkPincode();
        }
      });

      document.addEventListener('input', function (event) {
        if (event.target && event.target.id === 'sh-pincode-input') {
          event.target.value = event.target.value.replace(/\D/g, '').slice(0, 6);
        }
      });

      // Close mobile menu if viewport grows past the md breakpoint
      if (window.matchMedia) {
        var mq = window.matchMedia('(min-width: 768px)');
        var onChange = function (e) {
          if (e.matches) setMenu(false);
        };
        if (mq.addEventListener) mq.addEventListener('change', onChange);
        else if (mq.addListener) mq.addListener(onChange);
      }

      var ticking = false;
      var HIDE_THRESHOLD = 30;
      var SHOW_THRESHOLD = 5;

      window.addEventListener(
        'scroll',
        function () {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            var bar = $('sh-announce');
            if (bar) {
              var y = window.scrollY || window.pageYOffset;
              var isHidden = bar.getAttribute('data-hidden') === 'true';

              if (!isHidden && y > HIDE_THRESHOLD) {
                bar.setAttribute('data-hidden', 'true');
              } else if (isHidden && y < SHOW_THRESHOLD) {
                bar.setAttribute('data-hidden', 'false');
              }
            }
            ticking = false;
          });
        },
        { passive: true }
      );
    }

    function init() {
      portal(['sh-mobile-menu', 'sh-pincode-modal']);
      renderSaved();

      var saved = read(KEY_PIN);
      var modal = $('sh-pincode-modal');
      var checked = null;
      try {
        checked = sessionStorage.getItem('sh-pin-checked');
      } catch (e) {}

      if (saved && !checked && modal && modal.getAttribute('data-token')) {
        lookup(saved)
          .then(function (data) {
            try {
              sessionStorage.setItem('sh-pin-checked', '1');
            } catch (e) {}
            if (data && data.serviceable === false) {
              remove(KEY_PIN);
              remove(KEY_STORE);
              renderSaved();
            }
          })
          .catch(function () {});
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

