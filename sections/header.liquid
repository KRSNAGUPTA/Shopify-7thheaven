<!-- Announcement Bar -->
<div class="sh-announcement-bar">
  {{ 'general.announcement' | t }}
</div>

<!-- Main Header -->
<header class="sh-header">
  <div class="sh-container" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0;">
    <a href="{{ routes.root_url }}" style="font-size: 1.5rem; font-weight: 700; color: var(--sh-brown); text-decoration: none;">
      7th Heaven
    </a>

    <nav class="sh-nav sh-hide-mobile" aria-label="{{ 'general.primary_nav' | t }}">
      <a href="{{ routes.collections_url }}/cakes">{{ 'general.nav.cakes' | t }}</a>
      <a href="{{ routes.collections_url }}/cupcakes">{{ 'general.nav.cupcakes' | t }}</a>
      <a href="{{ routes.collections_url }}/desserts">{{ 'general.nav.desserts' | t }}</a>
      <a href="{{ pages.stores.url | default: '/pages/stores' }}">{{ 'general.nav.stores' | t }}</a>
      <a href="{{ pages.franchise.url | default: '/pages/franchise' }}">{{ 'general.nav.franchise' | t }}</a>
    </nav>

    <div style="display: flex; gap: 1rem; align-items: center;">
      <button type="button" class="sh-pincode-btn" id="sh-pincode-btn">
        <span id="sh-pincode-label">{{ 'general.enter_pincode' | t }}</span>
      </button>

      <a href="{{ routes.cart_url }}" data-cart-open style="font-size: 1.1rem; color: var(--sh-brown); text-decoration: none; position: relative;">
        {{ 'cart.title' | t }}
        <span data-cart-count hidden style="position:absolute;top:-8px;right:-12px;background:var(--sh-accent);color:#fff;border-radius:999px;font-size:0.7rem;padding:0.1rem 0.4rem;">0</span>
      </a>
    </div>
  </div>
</header>

<div id="sh-pincode-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: white; padding: 2rem; border-radius: 12px; max-width: 400px; width: calc(100% - 2rem); box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
    <h3 style="margin-bottom: 1rem; color: var(--sh-brown);">{{ 'general.pincode_title' | t }}</h3>
    <input
      type="text"
      id="sh-pincode-input"
      placeholder="{{ 'general.pincode_placeholder' | t }}"
      maxlength="6"
      inputmode="numeric"
      style="width: 100%; padding: 0.75rem; border: 1px solid var(--sh-border); border-radius: 6px; font-size: 1rem; margin-bottom: 1rem; box-sizing: border-box;"
    >
    <div id="sh-pincode-result" style="margin-bottom: 1rem; min-height: 40px;"></div>
    <div style="display: flex; gap: 1rem;">
      <button type="button" id="sh-pincode-check" class="sh-btn sh-btn--primary" style="flex: 1;">{{ 'general.check' | t }}</button>
      <button type="button" id="sh-pincode-close" class="sh-btn sh-btn--outline" style="flex: 1;">{{ 'general.close' | t }}</button>
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    var pincodeMap = {
      '400053': 'andheri', '400058': 'andheri', '400061': 'andheri', '400069': 'andheri', '400093': 'andheri',
      '400601': 'thane', '400602': 'thane', '400603': 'thane', '400604': 'thane', '400606': 'thane'
    };
    var storeNames = {
      andheri: '7th Heaven Andheri',
      thane: '7th Heaven Thane'
    };

    var pincodeBtn = document.getElementById('sh-pincode-btn');
    var pincodeModal = document.getElementById('sh-pincode-modal');
    var pincodeInput = document.getElementById('sh-pincode-input');
    var pincodeCheck = document.getElementById('sh-pincode-check');
    var pincodeClose = document.getElementById('sh-pincode-close');
    var pincodeResult = document.getElementById('sh-pincode-result');
    var pincodeLabel = document.getElementById('sh-pincode-label');

    var savedPincode = localStorage.getItem('sh-pincode');
    var savedStore = localStorage.getItem('sh-store');
    if (savedPincode && savedStore) {
      pincodeLabel.textContent = savedPincode + ' (' + storeNames[savedStore] + ')';
    }

    pincodeBtn.addEventListener('click', function () {
      pincodeModal.style.display = 'flex';
      pincodeInput.focus();
    });

    pincodeClose.addEventListener('click', function () {
      pincodeModal.style.display = 'none';
      pincodeResult.innerHTML = '';
    });

    pincodeCheck.addEventListener('click', function () {
      var pincode = pincodeInput.value.trim();
      if (!pincode || pincode.length !== 6 || isNaN(Number(pincode))) {
        pincodeResult.innerHTML = '<p style="color: var(--sh-accent); font-weight: 600;">Please enter a valid 6-digit pincode</p>';
        return;
      }

      if (pincodeMap[pincode]) {
        var store = pincodeMap[pincode];
        localStorage.setItem('sh-pincode', pincode);
        localStorage.setItem('sh-store', store);
        pincodeResult.innerHTML = '<p style="color: #1b6b36; font-weight: 600;">Delivering from ' + storeNames[store] + '</p>';
        window.dispatchEvent(new CustomEvent('sh:pincode-updated'));
        setTimeout(function () {
          pincodeLabel.textContent = pincode + ' (' + storeNames[store] + ')';
          pincodeModal.style.display = 'none';
          pincodeInput.value = '';
          pincodeResult.innerHTML = '';
        }, 800);
      } else {
        pincodeResult.innerHTML = '<p style="color: var(--sh-accent); font-weight: 600;">Sorry! Not serviceable yet in your area</p>';
      }
    });

    pincodeInput.addEventListener('keypress', function (e) {
      if (e.key === 'Enter') pincodeCheck.click();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
