{% style %}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 50;
  }
{% endstyle %}

{%- assign announcement = section.settings.announcement_text -%}
{%- if announcement == blank -%}
  {%- assign announcement = 'general.announcement' | t -%}
{%- endif -%}

{%- if section.settings.show_announcement -%}
  <div
    id="sh-announce"
    data-hidden="false"
    class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out data-[hidden=true]:grid-rows-[0fr] motion-reduce:transition-none"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="border-b border-sh-border bg-sh-cream-light text-sh-brown">
        <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-4 py-2 text-center text-xs font-medium tracking-wide sm:text-[13px]">
          <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sh-primary" aria-hidden="true"></span>
          {%- if section.settings.announcement_link != blank -%}
            <a href="{{ section.settings.announcement_link }}" class="text-sh-brown underline-offset-4 hover:text-sh-primary-dark hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary">
              {{ announcement }}
            </a>
          {%- else -%}
            <span>{{ announcement }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<header class="w-full border-b border-white/10 bg-sh-brown-dark/95 backdrop-blur-xl backdrop-saturate-150 supports-[backdrop-filter]:bg-sh-brown-dark/70">
  <div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-2 sm:px-6 md:flex md:py-2.5 lg:px-8">

    {%- comment -%}Mobile menu button{%- endcomment -%}
    <div class="md:hidden">
      <button
        type="button"
        data-menu-open
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.open_menu' | t }}"
        aria-controls="sh-mobile-menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
      </button>
    </div>

    {%- comment -%}Logo{%- endcomment -%}
    <a href="{{ routes.root_url }}" class="flex shrink-0 items-center justify-self-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_width -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{
          section.settings.logo
          | image_url: width: logo_width
          | image_tag:
            width: logo_width,
            height: logo_height,
            loading: 'eager',
            class: 'h-14 w-auto object-contain sm:h-16',
            alt: section.settings.logo.alt | default: shop.name | escape
        }}
      {%- else -%}
        <span class="text-xl font-extrabold tracking-tight text-white sm:text-2xl">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%}Desktop nav (pill){%- endcomment -%}
    <nav class="hidden md:flex md:flex-1 md:justify-center" aria-label="{{ 'general.primary_nav' | t }}">
      {%- if section.settings.menu != blank -%}
        <div class="flex items-center gap-1 rounded-full border border-white/10 bg-white/5 p-1">
          {%- for link in section.settings.menu.links -%}
            <a
              href="{{ link.url }}"
              {% if link.current %}aria-current="page"{% endif %}
              class="rounded-full px-4 py-2 text-sm font-semibold transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary {% if link.current %}bg-white/10 text-white{% else %}text-sh-cream/90{% endif %}"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </nav>

    {%- comment -%}Actions{%- endcomment -%}
    <div class="flex items-center justify-end gap-1.5 sm:gap-2">
      <button
        type="button"
        data-pincode-open
        class="inline-flex h-10 items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 text-sm font-semibold text-sh-cream transition-colors duration-200 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.enter_pincode' | t }}"
      >
        <svg class="h-4 w-4 shrink-0 text-sh-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span id="sh-pincode-label" data-default="{{ 'general.enter_pincode' | t | escape }}" class="hidden max-w-[8rem] truncate lg:inline">{{ 'general.enter_pincode' | t }}</span>
        <span id="sh-pincode-dot" class="hidden h-1.5 w-1.5 rounded-full bg-sh-success lg:hidden" aria-hidden="true"></span>
      </button>

      <a
        href="{{ routes.cart_url }}"
        data-cart-open
        class="relative inline-flex h-10 w-10 items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'cart.title' | t }}"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span
          data-cart-count
          {% if cart.item_count == 0 %}hidden{% endif %}
          class="absolute -right-0.5 -top-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full border-2 border-sh-brown-dark bg-sh-primary px-1 text-[10px] font-bold text-white"
        >
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </div>
</header>

{%- comment -%}Mobile menu{%- endcomment -%}
<div id="sh-mobile-menu" data-open="false" aria-hidden="true" class="group fixed inset-0 z-[1000] md:hidden">
  <div
    data-menu-close
    class="pointer-events-none invisible absolute inset-0 bg-sh-brown-dark/50 opacity-0 backdrop-blur-sm transition-opacity duration-300 group-data-[open=true]:pointer-events-auto group-data-[open=true]:visible group-data-[open=true]:opacity-100"
    aria-hidden="true"
  ></div>
  <nav
    class="absolute inset-y-0 left-0 flex w-80 max-w-[85%] -translate-x-full flex-col border-r border-white/10 bg-sh-brown-dark/95 backdrop-blur-xl transition-transform duration-300 group-data-[open=true]:translate-x-0 motion-reduce:transition-none"
    aria-label="{{ 'general.primary_nav' | t }}"
  >
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <span class="text-lg font-bold text-white">{{ 'general.menu' | t }}</span>
      <button
        type="button"
        data-menu-close
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-sh-cream transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.close_menu' | t }}"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-3">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="block rounded-xl px-4 py-3 text-base font-semibold text-sh-cream transition-colors hover:bg-white/10 hover:text-white">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="border-t border-white/10 p-4">
      <button
        type="button"
        data-pincode-open
        class="flex w-full items-center justify-center gap-2 rounded-full bg-sh-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-sh-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 focus-visible:ring-offset-sh-brown-dark"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {{ 'general.check_delivery' | t }}
      </button>
    </div>
  </nav>
</div>

{%- comment -%}Pincode modal (bottom sheet on mobile, centered on desktop){%- endcomment -%}
<div
  id="sh-pincode-modal"
  class="fixed inset-0 z-[1100] hidden items-end justify-center bg-sh-brown-dark/50 backdrop-blur-sm sm:items-center sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sh-pincode-title"
  data-token="{{ section.settings.storefront_token }}"
  data-variant="{{ section.settings.probe_variant_id }}"
  data-api-version="{{ section.settings.api_version | default: '2026-01' }}"
  data-msg-invalid="{{ 'general.pincode_invalid' | t | escape }}"
  data-msg-delivering="{{ 'general.pincode_delivering' | t | escape }}"
  data-msg-unavailable="{{ 'general.pincode_unavailable' | t | escape }}"
  data-msg-error="Couldn't check right now. Please try again."
>
  <div class="w-full max-w-md rounded-t-3xl border border-sh-border bg-sh-cream p-6 shadow-2xl sm:rounded-2xl">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sh-primary-light text-sh-primary-dark" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </span>
        <div>
          <h3 id="sh-pincode-title" class="text-lg font-bold text-sh-brown">{{ 'general.pincode_title' | t }}</h3>
          <p class="text-xs text-sh-text-light">{{ 'general.pincode_hint' | t }}</p>
        </div>
      </div>
      <button
        type="button"
        data-pincode-close
        class="rounded-full p-1.5 text-sh-text-light transition-colors hover:bg-sh-cream-light hover:text-sh-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary"
        aria-label="{{ 'general.close' | t }}"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <input
      type="text"
      id="sh-pincode-input"
      inputmode="numeric"
      maxlength="6"
      autocomplete="postal-code"
      placeholder="{{ 'general.pincode_placeholder' | t }}"
      class="w-full rounded-xl border border-sh-border bg-white px-4 py-3 text-base text-sh-brown transition-colors placeholder:text-sh-text-light/60 focus:border-sh-primary focus:outline-none focus:ring-2 focus:ring-sh-primary/40"
    >

    <div id="sh-pincode-result" class="mt-3 min-h-[20px] text-sm" aria-live="polite"></div>

    <div class="mt-4 flex gap-3">
      <button
        type="button"
        data-pincode-check
        class="flex-1 rounded-full bg-sh-primary px-4 py-3 font-semibold text-white transition-colors hover:bg-sh-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 disabled:opacity-70"
      >
        {{ 'general.check' | t }}
      </button>
      <button
        type="button"
        data-pincode-close
        class="flex-1 rounded-full bg-sh-cream-light px-4 py-3 font-semibold text-sh-brown transition-colors hover:bg-sh-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2"
      >
        {{ 'general.close' | t }}
      </button>
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    'use strict';

    var KEY_PIN = 'sh-pincode';
    var KEY_STORE = 'sh-store';
    var lastTrigger = null;
    var checking = false;

    function $(id) { return document.getElementById(id); }

    function read(key) {
      try { return localStorage.getItem(key); } catch (e) { return null; }
    }
    function write(key, value) {
      try { localStorage.setItem(key, value); } catch (e) {}
    }
    function remove(key) {
      try { localStorage.removeItem(key); } catch (e) {}
    }

    /* ---------- Delivery check (Shopify Storefront API) ---------- */
    function lookup(pin) {
      var modal = $('sh-pincode-modal');
      var token = modal && modal.getAttribute('data-token');
      var variant = modal && modal.getAttribute('data-variant');
      var version = (modal && modal.getAttribute('data-api-version')) || '2026-01';
      if (!token || !variant) return Promise.reject(new Error('Not configured'));

      var query =
        'mutation($input: CartInput!) {' +
        '  cartCreate(input: $input) {' +
        '    cart { deliveryGroups(first: 5) { nodes { deliveryOptions { deliveryMethodType } } } }' +
        '    userErrors { message }' +
        '  }' +
        '}';

      var variables = {
        input: {
          lines: [{ merchandiseId: 'gid://shopify/ProductVariant/' + variant, quantity: 1 }],
          buyerIdentity: {
            countryCode: 'IN',
            deliveryAddressPreferences: [{
              deliveryAddress: { zip: pin, country: 'IN', province: 'MH' }
            }]
          }
        }
      };

      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, 8000);

      return fetch('/api/' + version + '/graphql.json', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': token
        },
        body: JSON.stringify({ query: query, variables: variables }),
        signal: ctrl.signal
      })
        .then(function (r) {
          if (!r.ok) throw new Error('Bad response');
          return r.json();
        })
        .then(function (json) {
          var cart = json && json.data && json.data.cartCreate && json.data.cartCreate.cart;
          if (!cart) throw new Error('No cart');

          var groups = (cart.deliveryGroups && cart.deliveryGroups.nodes) || [];
          var local = groups.some(function (g) {
            return (g.deliveryOptions || []).some(function (o) {
              return o.deliveryMethodType === 'LOCAL';
            });
          });

          // Shopify doesn't say which location serves a pincode,
          // so no store name is returned.
          return { serviceable: local };
        })
        .finally(function () { clearTimeout(timer); });
    }

    /* ---------- Cart count ---------- */
    function setCartCount(count) {
      count = Number(count) || 0;
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = count > 99 ? '99+' : count;
        el.hidden = count <= 0;
      });
    }

    function refreshCartCount() {
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) { setCartCount(cart.item_count); })
        .catch(function () {});
    }

    document.addEventListener('cart:updated', function (event) {
      var cart = event && event.detail && event.detail.cart;
      if (cart && typeof cart.item_count !== 'undefined') setCartCount(cart.item_count);
      else refreshCartCount();
    });

    window.addEventListener('pageshow', function (event) {
      if (event.persisted) refreshCartCount();
    });

    /* ---------- Scroll lock ---------- */
    function syncLock() {
      var menu = $('sh-mobile-menu');
      var modal = $('sh-pincode-modal');
      var locked =
        (menu && menu.getAttribute('data-open') === 'true') ||
        (modal && !modal.classList.contains('hidden'));
      document.body.classList.toggle('overflow-hidden', !!locked);
    }

    /* ---------- Mobile menu ---------- */
    function setMenu(open) {
      var menu = $('sh-mobile-menu');
      if (!menu) return;
      menu.setAttribute('data-open', open ? 'true' : 'false');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      var btn = document.querySelector('[data-menu-open]');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      syncLock();
    }

    /* ---------- Pincode UI ---------- */
    function showResult(kind, text) {
      var box = $('sh-pincode-result');
      if (!box) return;
      box.textContent = '';
      if (!text) return;

      var p = document.createElement('p');
      p.className = 'font-semibold ' + (kind === 'ok' ? 'text-sh-success' : 'text-sh-error');
      p.textContent = text;
      box.appendChild(p);
    }

    function openModal() {
      var modal = $('sh-pincode-modal');
      var input = $('sh-pincode-input');
      if (!modal) return;
      setMenu(false);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      showResult('', '');
      if (input) {
        input.value = read(KEY_PIN) || '';
        window.setTimeout(function () { input.focus(); input.select(); }, 50);
      }
      syncLock();
    }

    function closeModal() {
      var modal = $('sh-pincode-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      syncLock();
      if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
    }

    function renderSaved() {
      var label = $('sh-pincode-label');
      var dot = $('sh-pincode-dot');
      if (!label) return;

      var pin = read(KEY_PIN);
      var ok = read(KEY_STORE);

      if (pin && ok) {
        label.textContent = pin;
        label.title = pin;
        if (dot) { dot.classList.remove('hidden'); dot.classList.add('inline-block'); }
      } else {
        label.textContent = label.getAttribute('data-default') || '';
        label.removeAttribute('title');
        if (dot) { dot.classList.add('hidden'); dot.classList.remove('inline-block'); }
      }
    }

    function checkPincode() {
      var modal = $('sh-pincode-modal');
      var input = $('sh-pincode-input');
      var btn = modal && modal.querySelector('[data-pincode-check]');
      if (!modal || !input || checking) return;

      var pin = (input.value || '').trim();
      if (!/^\d{6}$/.test(pin)) {
        showResult('error', modal.getAttribute('data-msg-invalid'));
        return;
      }

      checking = true;
      var original = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Checking...'; }

      lookup(pin)
        .then(function (data) {
          if (data && data.serviceable) {
            write(KEY_PIN, pin);
            write(KEY_STORE, 'local');
            showResult('ok', modal.getAttribute('data-msg-delivering') + ' ' + pin);
            renderSaved();
            window.dispatchEvent(new CustomEvent('sh:pincode-updated', {
              detail: { pincode: pin, serviceable: true }
            }));
          } else {
            remove(KEY_PIN);
            remove(KEY_STORE);
            renderSaved();
            showResult('error', modal.getAttribute('data-msg-unavailable'));
          }
        })
        .catch(function () {
          showResult('error', modal.getAttribute('data-msg-error'));
        })
        .finally(function () {
          checking = false;
          if (btn) { btn.disabled = false; btn.textContent = original; }
        });
    }

    /* ---------- Events (delegated, survive theme editor re-renders) ---------- */
    document.addEventListener('click', function (event) {
      var t = event.target;

      if (t.closest('[data-menu-open]')) { setMenu(true); return; }
      if (t.closest('[data-menu-close]')) { setMenu(false); return; }

      var opener = t.closest('[data-pincode-open]');
      if (opener) {
        event.preventDefault();
        lastTrigger = opener;
        openModal();
        return;
      }
      if (t.closest('[data-pincode-close]')) { closeModal(); return; }
      if (t.closest('[data-pincode-check]')) { checkPincode(); return; }

      var modal = $('sh-pincode-modal');
      if (modal && t === modal) closeModal();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        var modal = $('sh-pincode-modal');
        if (modal && !modal.classList.contains('hidden')) closeModal();
        setMenu(false);
      }
      if (event.key === 'Enter' && event.target && event.target.id === 'sh-pincode-input') {
        event.preventDefault();
        checkPincode();
      }
    });

    document.addEventListener('input', function (event) {
      if (event.target && event.target.id === 'sh-pincode-input') {
        event.target.value = event.target.value.replace(/\D/g, '').slice(0, 6);
      }
    });

    /* ---------- Announcement bar collapses on scroll ---------- */
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        var bar = $('sh-announce');
        if (bar) bar.setAttribute('data-hidden', window.scrollY > 24 ? 'true' : 'false');
        ticking = false;
      });
    }, { passive: true });

    /* ---------- Init ---------- */
    function init() {
      renderSaved();

      // Re-verify a saved pincode once per visit, so removed zones clear themselves
      var saved = read(KEY_PIN);
      var modal = $('sh-pincode-modal');
      var checked = null;
      try { checked = sessionStorage.getItem('sh-pin-checked'); } catch (e) {}

      if (saved && !checked && modal && modal.getAttribute('data-token')) {
        lookup(saved)
          .then(function (data) {
            try { sessionStorage.setItem('sh-pin-checked', '1'); } catch (e) {}
            if (data && data.serviceable === false) {
              remove(KEY_PIN);
              remove(KEY_STORE);
              renderSaved();
            }
          })
          .catch(function () {});
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
