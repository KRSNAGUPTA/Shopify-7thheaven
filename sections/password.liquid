{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="full-width flex min-h-screen items-center justify-center px-4 py-16">
  <div class="w-full max-w-sm text-center">
    <h1 class="mb-4">{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p class="mb-6 text-sh-text-light">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="mb-4">{{ form.errors | default_errors }}</div>
      {% endif %}

      <label for="password-input" class="mb-2 block text-left font-semibold text-sh-brown">
        {{ 'password.password' | t }}
      </label>

      <input type="password" name="password" id="password-input" class="w-full rounded-lg border border-sh-border px-4 py-3">

      <button type="submit" class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-sh-accent px-6 py-3 font-semibold text-white shadow-sm transition-all hover:bg-[#b8234c] active:scale-95">
        {{ 'password.enter' | t }}
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
