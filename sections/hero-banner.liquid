{%- comment -%}
Hero Banner Section with Fullscreen Background Image
{%- endcomment -%}

{%- assign bg_image = section.settings.background_image -%}

<div 
  class="relative w-full h-screen flex items-center justify-center text-white overflow-hidden bg-sh-brown-dark"
  {%- if bg_image != blank %}
  style="
    background-image: url('{{ bg_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  "
  {%- endif %}
>
  <div class="absolute inset-0 bg-sh-brown-dark/50 z-0"></div>

  <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <h1 class="font-sniglet text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight drop-shadow-lg mb-4">
      {{ section.settings.heading }}
    </h1>
    
    <p class="text-lg sm:text-xl text-sh-cream/90 font-light drop-shadow-md mb-8 max-w-2xl mx-auto">
      {{ section.settings.subheading }}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      {%- if section.settings.button_link != blank -%}
        <a 
          href="{{ section.settings.button_link }}" 
          class="w-full sm:w-auto inline-flex items-center justify-center bg-sh-primary hover:bg-sh-primary-dark text-white hover:text-white font-semibold text-lg px-8 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:scale-105 active:scale-95"
        >
          {{ section.settings.button_label | default: 'Shop Now' }}
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_button_link != blank -%}
        <a 
          href="{{ section.settings.secondary_button_link }}" 
          class="w-full sm:w-auto inline-flex items-center justify-center bg-sh-cream/10 hover:bg-sh-cream/20 text-white hover:text-white border border-sh-cream/50 backdrop-blur-md font-semibold text-lg px-8 py-3.5 rounded-full transition-all duration-200 shadow-lg hover:scale-105 active:scale-95"
        >
          {{ section.settings.secondary_button_label | default: 'Franchise Enquiry' }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Fullscreen Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "7th Heaven - Krishna"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handcrafted freshly baked treats with love and the finest ingredients"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Franchise Enquiry"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .font-sniglet {
    font-family: 'Sniglet', cursive, sans-serif;
  }
{% endstylesheet %}