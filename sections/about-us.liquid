{%- comment -%}
  About Us
  - Hero → Story (image + text) → Stats strip → Values grid → CTA
  - Blocks: "Stat" and "Value" (add, remove and reorder in the editor)
  - Optionally shows the page content written in Shopify admin at the bottom
{%- endcomment -%}

{%- assign stat_count = 0 -%}
{%- assign value_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'stat' -%}
    {%- assign stat_count = stat_count | plus: 1 -%}
  {%- elsif block.type == 'value' -%}
    {%- assign value_count = value_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign eyebrow_class = 'text-xs font-semibold uppercase leading-snug tracking-[0.12em] text-sh-primary-dark' -%}
{%- assign h2_class = 'font-sniglet text-[1.75rem] sm:text-4xl lg:text-5xl font-medium text-sh-brown tracking-[-0.02em] leading-[1.1] [text-wrap:balance]' -%}
{%- assign body_class = 'text-[0.95rem] sm:text-base lg:text-[1.0625rem] text-sh-text-light leading-[1.7] [text-wrap:pretty]' -%}

<div id="AboutUs-{{ section.id }}" class="font-body">

  {%- comment -%}Hero{%- endcomment -%}
  {%- if section.settings.hero_heading != blank -%}
    <section class="bg-sh-cream-light">
      <div class="mx-auto max-w-3xl px-5 py-14 text-center sm:px-6 sm:py-20 lg:px-8 lg:py-28">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="{{ eyebrow_class }}">{{ section.settings.hero_eyebrow }}</p>
        {%- endif -%}
        <h1 class="mt-3 font-sniglet text-[2rem] font-medium leading-[1.08] tracking-[-0.02em] text-sh-brown [text-wrap:balance] sm:text-5xl lg:text-6xl">
          {{ section.settings.hero_heading }}
        </h1>
        {%- if section.settings.hero_subheading != blank -%}
          <p class="mx-auto mt-4 max-w-xl text-[0.95rem] leading-[1.65] text-sh-text-light [text-wrap:pretty] sm:mt-5 sm:text-base lg:text-[1.125rem]">
            {{ section.settings.hero_subheading }}
          </p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}Story{%- endcomment -%}
  {%- if section.settings.story_heading != blank or section.settings.story_text != blank or section.settings.story_image != blank -%}
    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="{% if section.settings.image_position == 'right' %}lg:order-2{% endif %}">
          <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sh-cream-light">
            {%- if section.settings.story_image != blank -%}
              {{
                section.settings.story_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 1024px) 560px, 100vw',
                  class: 'h-full w-full object-cover',
                  alt: section.settings.story_image.alt | default: section.settings.story_heading | escape
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover text-sh-border' }}
            {%- endif -%}
          </div>
        </div>

        <div class="{% if section.settings.image_position == 'right' %}lg:order-1{% endif %}">
          {%- if section.settings.story_eyebrow != blank -%}
            <p class="{{ eyebrow_class }}">{{ section.settings.story_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.story_heading != blank -%}
            <h2 class="mt-3 {{ h2_class }}">{{ section.settings.story_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.story_text != blank -%}
            <div class="mt-5 space-y-4 {{ body_class }} [&_a]:text-sh-primary-dark [&_a]:underline [&_a]:underline-offset-4 [&_strong]:font-semibold [&_strong]:text-sh-brown">
              {{ section.settings.story_text }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}Stats strip{%- endcomment -%}
  {%- if stat_count > 0 -%}
    {%- case stat_count -%}
      {%- when 1 -%}{%- assign stat_cols = 'grid-cols-1' -%}
      {%- when 2 -%}{%- assign stat_cols = 'grid-cols-2' -%}
      {%- when 3 -%}{%- assign stat_cols = 'grid-cols-3' -%}
      {%- else -%}{%- assign stat_cols = 'grid-cols-2' -%}
    {%- endcase -%}
    <section class="bg-sh-brown text-white">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
        <div class="grid {{ stat_cols }} gap-x-3 gap-y-8 sm:flex sm:flex-wrap sm:items-stretch sm:justify-center sm:gap-0">
          {%- assign stat_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div
                class="flex flex-col items-center justify-center text-center sm:flex-1 sm:basis-0 sm:px-6 lg:px-10 {% if stat_index > 0 %}sm:border-l sm:border-white/10{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.value != blank -%}
                  <strong class="block font-sniglet text-[1.75rem] font-medium leading-none tracking-[-0.02em] text-white sm:text-4xl lg:text-5xl">
                    {{ block.settings.value }}
                  </strong>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="mt-2 block max-w-[10rem] text-[0.6875rem] font-semibold uppercase leading-snug tracking-[0.12em] text-sh-cream/80 [text-wrap:balance] sm:mt-3 sm:text-xs lg:text-[0.8125rem]">
                    {{ block.settings.label }}
                  </span>
                {%- endif -%}
              </div>
              {%- assign stat_index = stat_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}Values{%- endcomment -%}
  {%- if value_count > 0 -%}
    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
      {%- if section.settings.values_heading != blank or section.settings.values_subheading != blank -%}
        <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-12 lg:mb-16">
          {%- if section.settings.values_heading != blank -%}
            <h2 class="{{ h2_class }}">{{ section.settings.values_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.values_subheading != blank -%}
            <p class="mx-auto mt-3 max-w-xl text-[0.95rem] leading-[1.65] text-sh-text-light [text-wrap:pretty] sm:mt-4 sm:text-base lg:mt-5 lg:text-[1.125rem]">
              {{ section.settings.values_subheading }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8">
        {%- assign value_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            {%- assign value_index = value_index | plus: 1 -%}
            <div
              class="rounded-2xl border border-sh-border bg-sh-cream-light/60 p-6 sm:p-7"
              {{ block.shopify_attributes }}
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-sh-primary-light font-sniglet text-base font-medium text-sh-primary-dark" aria-hidden="true">
                {{ value_index }}
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="mt-4 font-sniglet text-xl font-medium leading-tight tracking-[-0.01em] text-sh-brown sm:text-2xl">
                  {{ block.settings.title }}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="mt-2 text-sm leading-[1.65] text-sh-text-light [text-wrap:pretty] sm:text-[0.95rem]">
                  {{ block.settings.text }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}CTA{%- endcomment -%}
  {%- if section.settings.cta_heading != blank -%}
    <section class="mx-auto max-w-7xl px-5 pb-12 sm:px-6 sm:pb-16 lg:px-8 lg:pb-24">
      <div class="mx-auto max-w-5xl rounded-3xl bg-sh-brown px-6 py-12 text-center sm:px-10 sm:py-16 lg:py-20">
        <h2 class="font-sniglet text-[1.75rem] font-medium leading-[1.1] tracking-[-0.02em] text-white [text-wrap:balance] sm:text-4xl lg:text-5xl">
          {{ section.settings.cta_heading }}
        </h2>
        {%- if section.settings.cta_text != blank -%}
          <p class="mx-auto mt-3 max-w-xl text-[0.95rem] leading-[1.65] text-sh-cream/80 [text-wrap:pretty] sm:mt-4 sm:text-base lg:text-[1.125rem]">
            {{ section.settings.cta_text }}
          </p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a
            href="{{ section.settings.cta_link }}"
            class="mt-7 inline-flex cursor-pointer items-center justify-center rounded-full bg-sh-primary px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-sh-primary-dark active:bg-sh-primary-dark/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sh-primary focus-visible:ring-offset-2 focus-visible:ring-offset-sh-brown sm:text-base"
          >
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}Page content from Shopify admin (optional){%- endcomment -%}
  {%- if section.settings.show_page_content and page.content != blank -%}
    <section class="mx-auto max-w-3xl px-5 pb-12 sm:px-6 sm:pb-16 lg:px-8 lg:pb-24">
      <div class="space-y-4 {{ body_class }} [&_a]:text-sh-primary-dark [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-8 [&_h2]:font-sniglet [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:text-sh-brown [&_h3]:mt-6 [&_h3]:font-sniglet [&_h3]:text-xl [&_h3]:font-medium [&_h3]:text-sh-brown [&_ul]:list-disc [&_ul]:pl-5">
        {{ page.content }}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About us",
  "settings": [
    { "type": "header", "content": "Hero" },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "About us"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Baked fresh, made with love"
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Subheading",
      "default": "India's premier cake and dessert chain, bringing live fresh bakery products to your celebrations."
    },

    { "type": "header", "content": "Story" },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Heading",
      "default": "A little heaven in every bite"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Text",
      "default": "<p>Tell your story here: how it started, what you believe in, and what makes your cakes and desserts different.</p><p>Use a second paragraph for what customers can expect from every order.</p>"
    },

    { "type": "header", "content": "Values" },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Heading",
      "default": "What we stand for"
    },
    {
      "type": "textarea",
      "id": "values_subheading",
      "label": "Subheading",
      "default": "The promises behind every cake we bake."
    },

    { "type": "header", "content": "Call to action" },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Ready to celebrate?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Text",
      "default": "Order fresh cakes and desserts delivered to your door."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },

    { "type": "header", "content": "Page content" },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page content from Shopify admin",
      "info": "Displays the text written in Online Store → Pages → About us.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "350+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Outlets" }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Always fresh" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Baked live in our outlets, so every order is made fresh."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About us",
      "blocks": [
        { "type": "stat", "settings": { "value": "350+", "label": "Outlets" } },
        { "type": "stat", "settings": { "value": "125+", "label": "Cities" } },
        { "type": "stat", "settings": { "value": "7 min", "label": "Live cakes" } },
        {
          "type": "value",
          "settings": {
            "title": "Always fresh",
            "text": "Baked live in our outlets, so every order is made fresh."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Premium ingredients",
            "text": "We choose quality ingredients for rich flavour in every bite."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Made to celebrate",
            "text": "From birthdays to everyday treats, we bake for life's sweet moments."
          }
        }
      ]
    }
  ]
}
{% endschema %}